ALPACA_API_KEY=your_paper_api_key
ALPACA_API_SECRET=your_paper_api_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
DATABASE_URL="file:./dev.db"
ANTHROPIC_API_KEY=your_anthropic_api_key

# Clerk authentication (required for private dashboard and API routes)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_OWNER_USER_ID=user_your_owner_user_id
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Tradovate Futures (required for futures agent / Railway engine)
TRADOVATE_USERNAME=your_tradovate_username
TRADOVATE_PASSWORD=your_tradovate_password
TRADOVATE_APP_ID=your_app_id
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=your_cid
TRADOVATE_SEC=your_sec

# Vercel Cron
CRON_SECRET=your_cron_secret

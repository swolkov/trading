<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Four runs a weekday. launchd cannot vary the environment per StartCalendarInterval, so the slice is
     chosen inside options-market-run.sh by ET hour: 10:15 and 15:15 read slice A (index/mega + affordable
     core), 12:15 and 17:45 read slice B (large caps + scanner discovery). RESEARCH_SLICE=A|B overrides. -->
<dict>
	<key>Label</key>
	<string>com.esbueno.options-market</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>cd /Users/user/trading-rh-options &amp;&amp; git fetch --quiet origin main &amp;&amp; git merge --ff-only --quiet origin/main &amp;&amp; exec scripts/options-market-run.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/Users/user/Library/Logs/options-market-launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/user/Library/Logs/options-market-launchd.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>15</integer>
			<key>Weekday</key>
			<integer>1</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>12</integer>

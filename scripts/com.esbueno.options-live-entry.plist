  <string>com.esbueno.options-live-entry</string>
  <!-- The options ENTRY tick: :05 and :35 each hour, weekdays; the script gates on the regular session and the last-30-minutes rule. The checkout is advanced without discarding other sessions' files. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>D=/Users/user/trading-rh-options; L="$HOME/Library/Logs/options-live.log"; if ! (git -C "$D" fetch --quiet origin main &amp;&amp; git -C "$D" merge --ff-only --quiet FETCH_HEAD); then echo "$(date -u +%FT%TZ) [warn] could not update $D — running the existing checkout" &gt;&gt; "$L"; fi; if [ -x "$D/scripts/options-live-run.sh" ]; then OPTIONS_DESK_REPO="$D" exec "$D/scripts/options-live-run.sh" entry; else echo "$(date -u +%FT%TZ) [fail] runner missing at $D" &gt;&gt; "$L"; fi</string>
  </array>

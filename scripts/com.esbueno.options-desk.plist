<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.esbueno.options-desk</string>

  <!-- Read-only account snapshots after each weekday close. OAuth stays on this Mac.
       The dedicated checkout is advanced without discarding other sessions' files. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>D=/Users/user/trading-rh-options; L="$HOME/Library/Logs/options-desk.log"; if ! (git -C "$D" fetch --quiet origin main &amp;&amp; git -C "$D" merge --ff-only --quiet FETCH_HEAD); then echo "$(date -u +%FT%TZ) [warn] could not update $D — running the existing checkout" &gt;&gt; "$L"; fi; if [ -x "$D/scripts/options-desk-run.sh" ]; then OPTIONS_DESK_REPO="$D" exec "$D/scripts/options-desk-run.sh"; else echo "$(date -u +%FT%TZ) [fail] runner missing at $D" &gt;&gt; "$L"; fi</string>
  </array>

  <!-- Weekdays, 17:32 local. After the 16:00 close, before the Vercel cron at 18:00 ET.
       Off the :00/:30 marks on purpose. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>32</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/user/Library/Logs/options-desk-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/user/Library/Logs/options-desk-launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>

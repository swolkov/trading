//@version=6
// ICT SETUPS SELF-TEST — GENERATED by build-ict.sh from ict-core.pine + ict-selftest-block.pine on 2026-09-24. Do not edit.
indicator("ICT Setups — Self-test", shorttitle="ICT Self-test", overlay=true, behind_chart=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)
bool IS_STRATEGY = false
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// ICT SETUPS — shared core. SINGLE SOURCE OF TRUTH for every rule.
// Do not edit ict-setups.pine / ict-setups-strategy.pine by hand: edit this file, then run
// tradingview/build-ict.sh, which prepends the indicator() or strategy() declaration.
//
// Non-repainting contract:
//  • Every rule runs on CLOSED bars only (barstate.isconfirmed). History and live behave the same.
//  • Higher timeframes arrive through ONE request.security per timeframe using [1] +
//    lookahead_on (the last COMPLETED HTF candle) and are fed to their engine only when that
//    candle's timestamp changes, so no HTF candle is ever processed twice.
//  • Anything that depends on the still-open bar is shown as DEVELOPING, never CONFIRMED.
// ═══════════════════════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────── inputs ─────────────────────────────────────────
G_INS = "Instrument"
presetIn   = input.string("Auto", "Preset", options=["Auto", "MES", "MNQ", "MGC"], group=G_INS,
     tooltip="Auto reads the chart symbol. Thresholds are ATR-relative on every instrument; the preset only sets the tick floor for gaps and the cash session (MGC uses the 08:20–13:30 COMEX session).")

G_TF = "Timeframes (chart = execution timeframe; 5m preferred)"
tf4H   = input.timeframe("240", "Major context", group=G_TF, inline="t1")
on4H   = input.bool(true, "show zones", group=G_TF, inline="t1")
tf1H   = input.timeframe("60",  "Intraday bias", group=G_TF, inline="t2")
on1H   = input.bool(true, "show zones", group=G_TF, inline="t2")
tf15   = input.timeframe("15",  "Setup / location", group=G_TF, inline="t3")
on15   = input.bool(true, "show zones", group=G_TF, inline="t3")
onX    = input.bool(true, "Show chart-timeframe zones", group=G_TF)

G_FVG = "Fair value gaps"
showFVG    = input.bool(true, "Show FVGs", group=G_FVG)
showIFVG   = input.bool(true, "Show inverse FVGs (iFVG)", group=G_FVG)
showCE     = input.bool(true, "Show 50% line (consequent encroachment)", group=G_FVG)
fvgMinATR  = input.float(0.20, "Min gap size (× ATR of its timeframe)", minval=0, step=0.05, group=G_FVG)
maxAgeBars = input.int(150, "Forget a zone after this many bars of its timeframe", minval=10, group=G_FVG)
maxKeep    = input.int(12, "Zones tracked per timeframe", minval=2, maxval=40, group=G_FVG)
maxShow    = input.int(2, "Zones SHOWN per timeframe (nearest first)", minval=0, maxval=12, group=G_FVG)
relevATR   = input.float(2.5, "Only show zones within × ATR (of the zone's timeframe) of price", minval=0.5, step=0.5, group=G_FVG)

G_LIQ = "Liquidity"
showLiq    = input.bool(true, "Show liquidity levels", group=G_LIQ)
showPW     = input.bool(true, "Include previous week high/low", group=G_LIQ)
showSess   = input.bool(true, "Show current cash-session high/low", group=G_LIQ)
liqShow    = input.int(3, "Levels shown above and below price", minval=1, maxval=8, group=G_LIQ)
swingLen   = input.int(5, "Swing strength on the chart timeframe (bars each side)", minval=2, maxval=15, group=G_LIQ)
htfLen     = input.int(3, "Swing strength on 15M / 1H / 4H", minval=2, maxval=10, group=G_LIQ)
promATR    = input.float(1.0, "A chart swing counts as liquidity only if it stands out by ≥ × ATR", minval=0, step=0.25, group=G_LIQ)
eqTolATR   = input.float(0.10, "Equal highs/lows tolerance (× ATR)", minval=0.01, step=0.01, group=G_LIQ)
reclaimBars = input.int(3, "Sweep: bars allowed to close back inside the level", minval=1, maxval=10, group=G_LIQ,
     tooltip="A SWEEP = price trades through the level, then a candle CLOSES back on the original side within this many bars. If it doesn't, the level was simply taken (run), not swept.")
useCustomSess = input.bool(false, "Custom sessions (otherwise preset: MES/MNQ 09:30–16:00, MGC 08:20–13:30 ET)", group=G_LIQ)
customRTH  = input.session("0930-1600", "Cash session (ET)", group=G_LIQ)
customON   = input.session("1800-0930", "Overnight session (ET)", group=G_LIQ)

G_MS = "Structure & displacement"
showStruct = input.bool(true, "Show BOS / CHoCH on the chart timeframe", group=G_MS)
showDisp   = input.bool(true, "Mark displacement candles", group=G_MS)
dispATR    = input.float(1.3, "Displacement: body ≥ × ATR", minval=0.3, step=0.1, group=G_MS)
dispBodyPct = input.float(0.60, "Displacement: body ≥ this share of the candle's range", minval=0.3, maxval=0.95, step=0.05, group=G_MS)
iLen       = input.int(2, "Internal swing strength (used for MSS)", minval=1, maxval=5, group=G_MS,
     tooltip="MSS / CHoCH for setups breaks the most recent INTERNAL swing (short-term high/low) that led into the sweep. BOS / CHoCH labels on the chart use the main swing strength.")
maxStructShow = input.int(6, "BOS / CHoCH labels kept", minval=1, maxval=20, group=G_MS)

G_SET = "Setups (sweep → displacement → MSS → iFVG → retest)"
setupsOn   = input.bool(true, "Detect LONG / SHORT setups", group=G_SET)
ctxMode    = input.string("Balanced", "Higher-timeframe context", options=["Strict", "Balanced", "Off"], group=G_SET,
     tooltip="Strict: 1H bias must agree and 4H must not disagree.\nBalanced: 1H must not disagree, AND at least one of: 1H agrees, 4H agrees, the sweep tapped a 15M/1H/4H zone in the trade's direction, or the swept level was overnight / prior-day / prior-week / 1H-4H swing liquidity.\nOff: no HTF filter.")
useWin     = input.bool(true, "Only start setups / take entries inside", group=G_SET, inline="win")
winSess    = input.session("0930-1400", "", group=G_SET, inline="win")
mssWindow  = input.int(12, "Bars allowed from the sweep to the MSS", minval=2, maxval=60, group=G_SET)
ifvgWindow = input.int(12, "Bars allowed from the MSS to the iFVG", minval=1, maxval=60, group=G_SET)
readyWindow = input.int(24, "Bars a READY setup waits for its retest", minval=2, maxval=120, group=G_SET)
entryRef   = input.string("Zone edge", "Entry price inside the iFVG", options=["Zone edge", "50% of zone"], group=G_SET,
     tooltip="Zone edge = the first touch of the iFVG (more fills, less R:R). 50% = consequent encroachment (fewer fills).")
stopBufATR = input.float(0.10, "Stop buffer beyond the sweep extreme (× ATR)", minval=0, step=0.05, group=G_SET)
minTgtR    = input.float(0.5, "Ignore targets closer than × R", minval=0, step=0.25, group=G_SET)
cooldown   = input.int(3, "Bars to wait after a setup ends", minval=0, maxval=50, group=G_SET)

G_TRD = "Entry / invalidation / targets"
showPlan   = input.bool(true, "Draw entry zone, stop and targets", group=G_TRD)
exitPlan   = input.string("TP1", "Exit plan used for the results table", options=["TP1", "TP2", "Thirds (TP1/TP2/TP3)"], group=G_TRD,
     tooltip="How the built-in results (and the strategy version) exit a filled setup. If a target doesn't exist, the previous one is used. The stop never moves.")
flatSess   = input.session("0930-1550", "Must be flat outside (ET)", group=G_TRD,
     tooltip="Bars are judged by their OPEN time: 0930-1550 means the last bar allowed to hold a trade is the 15:50 bar, and the exit is at its close = 15:55.")
feeMES     = input.float(1.08, "Fees per contract per side — MES ($)", minval=0, step=0.01, group=G_TRD, tooltip="Measured from your Tradovate journal (Sep 20–23): MES $2.165 round trip.")
feeMNQ     = input.float(1.03, "Fees per contract per side — MNQ ($)", minval=0, step=0.01, group=G_TRD, tooltip="Journal shows exactly $2.06 round trip — likely the flat estimate, not a per-fill measurement. Correct it from your statements.")
feeMGC     = input.float(1.03, "Fees per contract per side — MGC ($)", minval=0, step=0.01, group=G_TRD, tooltip="Journal shows exactly $2.06 round trip — likely the flat estimate, not a per-fill measurement. Correct it from your statements.")
stopSlip   = input.int(1, "Stop slippage (ticks)", minval=0, maxval=10, group=G_TRD)
qtyC       = input.int(1, "Contracts (results table)", minval=1, maxval=100, group=G_TRD)

pendBars   = input.int(3, "ENTRY READY: limit order stays valid for (bars)", minval=1, maxval=24, group=G_TRD,
     tooltip="After ENTRY READY the entry is a limit at the entry price. If it hasn't filled within this many chart bars — or anything invalidates first — it is cancelled. No stale orders.")
chaseR     = input.float(0.5, "MISSED — DO NOT CHASE when price closes this far past the entry (× R) unfilled", minval=0.1, step=0.1, group=G_TRD)
maxRiskUSD = input.float(0, "My max $ risk per trade (0 = don't size)", minval=0, step=25, group=G_TRD,
     tooltip="Optional. If set, the dashboard shows the largest whole number of contracts whose stop-out (plus round-trip fees) fits inside it. Nothing is assumed if you leave it at 0.")

G_PRC = "1-minute precision"
precOn     = input.bool(false, "Require 1M confirmation", group=G_PRC,
     tooltip="After price reaches a READY 5m iFVG, the 1-minute chart must show: liquidity sweep → displacement → MSS → FVG/iFVG → retest. Only then: PRECISION ENTRY READY (limit at the 1m zone). 1m setups are never taken on their own. If TradingView has no 1m history for that date, the setup is marked 1M DATA UNAVAILABLE and left out of the results — it is NOT counted as a failed confirmation.")
precBars   = input.int(6, "Chart bars allowed for the 1M confirmation", minval=1, maxval=24, group=G_PRC)

G_DSH = "Dashboard & alerts"
showDash   = input.bool(true, "Show dashboard", group=G_DSH)
dashPos    = input.string("Bottom left", "Dashboard position", options=["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group=G_DSH)
dashWrap   = input.int(58, "Dashboard line length (characters)", minval=30, maxval=120, group=G_DSH,
     tooltip="Long sentences are wrapped at this many characters so the dashboard stays narrow instead of stretching across the chart.")
dashSize   = input.string("Tiny", "Dashboard text", options=["Tiny", "Small", "Normal"], group=G_DSH)
showGloss  = input.bool(false, "Beginner glossary (what SSL, MSS, iFVG… mean)", group=G_DSH)
showStats  = input.bool(false, "Show results on loaded history", group=G_DSH)
alertsOn   = input.bool(true, "Alerts on", group=G_DSH)
alAction   = input.bool(true, "Alert: ACTION RIGHT NOW changes", group=G_DSH)
alSweep    = input.bool(false, "Alert: liquidity sweep (overnight / prior day / week / 1H-4H only)", group=G_DSH)
alMss      = input.bool(false, "Alert: setup MSS confirmed", group=G_DSH)
alIFVG     = input.bool(false, "Alert: iFVG created (chart timeframe)", group=G_DSH)
alRetest   = input.bool(true, "Alert: retest occurring (price in the entry zone)", group=G_DSH)

debugOn  = input.bool(false, "Debug readout", group="Advanced")
qaLog    = input.bool(false, "QA log (Pine Logs): every FVG/iFVG/setup event + rule-order checks", group="Advanced")

G_COL = "Colours"
cBull    = input.color(color.new(#089981, 0), "Bull FVG", group=G_COL, inline="c1")
cBear    = input.color(color.new(#F23645, 0), "Bear FVG", group=G_COL, inline="c1")
cBullInv = input.color(color.new(#2962FF, 0), "Bull iFVG", group=G_COL, inline="c2")
cBearInv = input.color(color.new(#FF9800, 0), "Bear iFVG", group=G_COL, inline="c2")

// ───────────────────────────────────────────── instrument ─────────────────────────────────────
string ROOT = syminfo.root
string INS = presetIn != "Auto" ? presetIn :
     (ROOT == "NQ" or ROOT == "MNQ") ? "MNQ" : (ROOT == "GC" or ROOT == "MGC") ? "MGC" : "MES"
int   FVG_MIN_TICKS = INS == "MNQ" ? 4 : 2
float TICK = syminfo.mintick
string TZ  = "America/New_York"
string RTH_SESS = useCustomSess ? customRTH : INS == "MGC" ? "0820-1330" : "0930-1600"
float FEE_SIDE = INS == "MNQ" ? feeMNQ : INS == "MGC" ? feeMGC : feeMES
string ON_SESS  = useCustomSess ? customON  : INS == "MGC" ? "1800-0820" : "1800-0930"

// ───────────────────────────────────────────── helpers ────────────────────────────────────────
f_tfLabel(int sec) =>
    sec >= 86400 ? "D" : sec >= 3600 ? str.tostring(sec / 3600) + "H" : str.tostring(sec / 60) + "M"

f_px(float p) =>
    str.tostring(p, format.mintick)

// ───────────────────────────────────────────── types ──────────────────────────────────────────
// A fair value gap. `bull` is its CURRENT polarity: an inverted bearish FVG is a bull iFVG.
type Zone
    bool  bull
    bool  inv      = false
    float top
    float bot
    int   tLeft            // open time of candle 1
    int   tMade            // open time of candle 3 (the zone exists from that candle's close)
    int   tInv     = 0     // open time of the candle whose close inverted it
    int   age      = 0     // closed bars of its timeframe since it was made
    bool  dead     = false // failed (closed through) or aged out
    bool  dropped  = false // pushed out of the tracking list by newer zones (NOT a failure)

// One timeframe's state machine, fed one CLOSED bar at a time.
type Engine
    string       tf
    int          rank          // 0 = chart TF, 1 = 15M, 2 = 1H, 3 = 4H
    int          sec
    array<float> o
    array<float> h
    array<float> l
    array<float> c
    array<int>   t
    int          n    = 0      // bars fed
    float        atr  = na
    array<Zone>  zones
    // events from the LAST fed bar (reset on every feed)
    bool         evBullFVG  = false
    bool         evBearFVG  = false
    bool         evBullIFVG = false
    bool         evBearIFVG = false
    Zone         lastIFVG                  // most recent zone that became an iFVG
    // confirmed swings (a pivot is only known `pLen` bars after it printed — no look-ahead)
    int          pLen   = 3
    float        lastPH = na
    int          tPH    = 0
    float        lastPL = na
    int          tPL    = 0
    bool         evPH   = false            // a new swing high was confirmed on the last fed bar
    bool         evPL   = false
    float        promPH = 0.0              // how far the new swing stands out (price units)
    float        promPL = 0.0
    // internal swings (short strength) — the levels an MSS breaks
    float        lastIPH = na
    int          tIPH    = 0
    float        lastIPL = na
    int          tIPL    = 0
    array<float> ipH
    array<int>   ipHt
    array<float> ipL
    array<int>   ipLt
    // structure
    int          trend    = 0              // +1 bullish, -1 bearish, 0 unknown
    bool         phBroken = true
    bool         plBroken = true
    bool         evBosUp  = false
    bool         evBosDn  = false
    bool         evChUp   = false          // CHoCH / MSS on the main swings
    bool         evChDn   = false
    float        brkLvl   = na
    int          brkT     = 0
    // displacement
    float        atrPrev   = na
    bool         evDispUp  = false
    bool         evDispDn  = false
    int          lastDispDir = 0
    int          lastDispN   = -999
    // own-swing sweeps and zone reactions (bias inputs)
    int          lastSweepDir = 0          // +1 = sell-side swept (bullish), -1 = buy-side swept
    int          lastSweepN   = -999
    int          lastZoneDir  = 0          // +1 = bullish zone respected / bull iFVG made
    int          lastZoneN    = -999

f_engine(string tf, int rank, int sec, int pLen) =>
    Engine.new(tf=tf, rank=rank, sec=sec, o=array.new<float>(), h=array.new<float>(), l=array.new<float>(),
         c=array.new<float>(), t=array.new<int>(), zones=array.new<Zone>(), pLen=pLen,
         ipH=array.new<float>(), ipHt=array.new<int>(), ipL=array.new<float>(), ipLt=array.new<int>())

// ───────────────────────────────────────────── engine: bars ───────────────────────────────────
KEEP_BARS = 60

method addBar(Engine e, float o_, float h_, float l_, float c_, int t_) =>
    e.o.unshift(o_), e.h.unshift(h_), e.l.unshift(l_), e.c.unshift(c_), e.t.unshift(t_)
    if e.o.size() > KEEP_BARS
        e.o.pop(), e.h.pop(), e.l.pop(), e.c.pop(), e.t.pop()
    e.n += 1
    e.atrPrev := e.atr
    // displacement is judged against the ATR BEFORE this candle
    float body = math.abs(c_ - o_)
    if not na(e.atrPrev) and body >= dispATR * e.atrPrev and body >= dispBodyPct * (h_ - l_)
        e.evDispUp := c_ > o_, e.evDispDn := c_ < o_
        e.lastDispDir := c_ > o_ ? 1 : -1, e.lastDispN := e.n
    // Wilder ATR(14) on this timeframe's own closed bars (SMA of TR until 14 bars exist)
    float tr = e.c.size() > 1 ? math.max(h_ - l_, math.abs(h_ - e.c.get(1)), math.abs(l_ - e.c.get(1))) : h_ - l_
    e.atr := na(e.atr) ? tr : e.n <= 14 ? (e.atr * (e.n - 1) + tr) / e.n : (e.atr * 13 + tr) / 14

// ───────────────────────────────────────────── engine: FVG / iFVG ─────────────────────────────
// Runs AFTER addBar() — index 0 is the bar that just closed.
method updateZones(Engine e) =>
    float c0 = e.c.get(0)
    // 1) existing zones: age, invert, or die — judged on this timeframe's CLOSE only
    if e.zones.size() > 0
        for i = e.zones.size() - 1 to 0
            Zone z = e.zones.get(i)
            z.age += 1
            bool kill = z.age > maxAgeBars
            if not kill
                if not z.inv
                    if qaLog and e.rank >= 0 and ((z.bull and c0 < z.bot) or (not z.bull and c0 > z.top))
                        log.info("QA INV {0} {1} FVG → {2} iFVG on the {0} candle opened {3} · close {4} vs edge {5}", e.tf, z.bull ? "BULL" : "BEAR",
                             z.bull ? "BEAR" : "BULL", str.format_time(e.t.get(0), "yyyy-MM-dd HH:mm", TZ), str.tostring(c0), str.tostring(z.bull ? z.bot : z.top))
                    if z.bull and c0 < z.bot                  // bull FVG closed through its bottom
                        z.bull := false, z.inv := true, z.tInv := e.t.get(0), z.age := 0
                        e.evBearIFVG := true, e.lastIFVG := z, e.lastZoneDir := -1, e.lastZoneN := e.n
                    else if not z.bull and c0 > z.top         // bear FVG closed through its top
                        z.bull := true, z.inv := true, z.tInv := e.t.get(0), z.age := 0
                        e.evBullIFVG := true, e.lastIFVG := z, e.lastZoneDir := 1, e.lastZoneN := e.n
                else
                    // an iFVG fails when price closes back through it
                    kill := (z.bull and c0 < z.bot) or (not z.bull and c0 > z.top)
                // a zone is "respected" when price trades into it and closes back out on its side
                if not kill and z.age > 0
                    if z.bull and e.l.get(0) <= z.top and c0 > z.top
                        e.lastZoneDir := 1, e.lastZoneN := e.n
                    else if not z.bull and e.h.get(0) >= z.bot and c0 < z.bot
                        e.lastZoneDir := -1, e.lastZoneN := e.n
            if kill
                z.dead := true
                e.zones.remove(i)
    // 2) new gap: candle 1 = [2], candle 3 = [0]
    if e.h.size() >= 3
        float minGap = math.max(fvgMinATR * nz(e.atr), FVG_MIN_TICKS * TICK)
        if qaLog and e.rank >= 0 and ((e.h.get(2) < e.l.get(0) and e.l.get(0) - e.h.get(2) >= minGap) or (e.l.get(2) > e.h.get(0) and e.l.get(2) - e.h.get(0) >= minGap))
            log.info("QA FVG {0} {1} · candle1 {2} · candle3 {3} (closed) · c1 H/L {4}/{5} · c3 H/L {6}/{7}", e.tf,
                 e.h.get(2) < e.l.get(0) ? "BULL" : "BEAR", str.format_time(e.t.get(2), "yyyy-MM-dd HH:mm", TZ), str.format_time(e.t.get(0), "yyyy-MM-dd HH:mm", TZ),
                 str.tostring(e.h.get(2)), str.tostring(e.l.get(2)), str.tostring(e.h.get(0)), str.tostring(e.l.get(0)))
        if e.h.get(2) < e.l.get(0) and e.l.get(0) - e.h.get(2) >= minGap
            e.zones.push(Zone.new(true, false, e.l.get(0), e.h.get(2), e.t.get(2), e.t.get(0)))
            e.evBullFVG := true
        else if e.l.get(2) > e.h.get(0) and e.l.get(2) - e.h.get(0) >= minGap
            e.zones.push(Zone.new(false, false, e.l.get(2), e.h.get(0), e.t.get(2), e.t.get(0)))
            e.evBearFVG := true
    // 3) cap: drop the oldest
    while e.zones.size() > maxKeep
        Zone zd = e.zones.shift()
        zd.dropped := true

// ───────────────────────────────────────────── engine: swings ─────────────────────────────────
// The bar `pLen` back is a swing high if no bar on either side (pLen each) is higher. It is
// CONFIRMED only now, pLen bars later — exactly when a trader could have known it.
method pivotAt(Engine e, int k) =>
    bool isH = false
    bool isL = false
    float lo = na
    float hi = na
    if e.h.size() >= 2 * k + 1
        float ph = e.h.get(k)
        float pl = e.l.get(k)
        isH := true, isL := true, lo := pl, hi := ph
        for j = 0 to 2 * k
            if j != k
                isH := isH and (j < k ? e.h.get(j) < ph : e.h.get(j) <= ph)
                isL := isL and (j < k ? e.l.get(j) > pl : e.l.get(j) >= pl)
            lo := math.min(lo, e.l.get(j))
            hi := math.max(hi, e.h.get(j))
    [isH, isL, lo, hi]

method updateInternal(Engine e) =>
    [isH, isL, lo, hi] = e.pivotAt(iLen)
    if isH
        e.lastIPH := e.h.get(iLen), e.tIPH := e.t.get(iLen)
        e.ipH.push(e.lastIPH), e.ipHt.push(e.tIPH)
        if e.ipH.size() > 12
            e.ipH.shift(), e.ipHt.shift()
    if isL
        e.lastIPL := e.l.get(iLen), e.tIPL := e.t.get(iLen)
        e.ipL.push(e.lastIPL), e.ipLt.push(e.tIPL)
        if e.ipL.size() > 12
            e.ipL.shift(), e.ipLt.shift()

// BOS = close beyond the last swing in the trend's direction; CHoCH = close beyond it AGAINST the
// current trend (the first break that flips structure). Closes only — wicks don't count.
method updateStructure(Engine e) =>
    float c0 = e.c.get(0)
    // own-swing sweeps: wick beyond the swing, close back inside
    if not na(e.lastPH) and not e.phBroken and e.h.get(0) > e.lastPH and c0 < e.lastPH
        e.lastSweepDir := -1, e.lastSweepN := e.n
    if not na(e.lastPL) and not e.plBroken and e.l.get(0) < e.lastPL and c0 > e.lastPL
        e.lastSweepDir := 1, e.lastSweepN := e.n
    if not na(e.lastPH) and not e.phBroken and c0 > e.lastPH
        e.phBroken := true
        e.evChUp := e.trend == -1, e.evBosUp := e.trend != -1
        e.trend := 1, e.brkLvl := e.lastPH, e.brkT := e.tPH
    if not na(e.lastPL) and not e.plBroken and c0 < e.lastPL
        e.plBroken := true
        e.evChDn := e.trend == 1, e.evBosDn := e.trend != 1
        e.trend := -1, e.brkLvl := e.lastPL, e.brkT := e.tPL

method bias(Engine e) =>
    int sc = e.trend * 2
    sc += e.n - e.lastSweepN <= 10 ? e.lastSweepDir : 0
    sc += e.n - e.lastZoneN <= 10 ? e.lastZoneDir : 0
    sc += e.n - e.lastDispN <= 5 ? e.lastDispDir : 0
    if not na(e.lastPH) and not na(e.lastPL) and e.c.size() > 0
        sc += e.c.get(0) > (e.lastPH + e.lastPL) / 2 ? 1 : -1
    sc

method updatePivots(Engine e) =>
    int k = e.pLen
    if e.h.size() >= 2 * k + 1
        float ph = e.h.get(k)
        float pl = e.l.get(k)
        bool isH = true
        bool isL = true
        float lo = pl
        float hi = ph
        for j = 0 to 2 * k
            if j != k
                // strict on the newer side, non-strict on the older side (first of equal highs wins)
                isH := isH and (j < k ? e.h.get(j) < ph : e.h.get(j) <= ph)
                isL := isL and (j < k ? e.l.get(j) > pl : e.l.get(j) >= pl)
            lo := math.min(lo, e.l.get(j))
            hi := math.max(hi, e.h.get(j))
        if isH
            e.lastPH := ph, e.tPH := e.t.get(k), e.evPH := true, e.promPH := ph - lo, e.phBroken := false
        if isL
            e.lastPL := pl, e.tPL := e.t.get(k), e.evPL := true, e.promPL := hi - pl, e.plBroken := false

method feed(Engine e, float o_, float h_, float l_, float c_, int t_) =>
    e.evBullFVG := false, e.evBearFVG := false, e.evBullIFVG := false, e.evBearIFVG := false
    e.evPH := false, e.evPL := false
    e.evBosUp := false, e.evBosDn := false, e.evChUp := false, e.evChDn := false
    e.evDispUp := false, e.evDispDn := false
    e.addBar(o_, h_, l_, c_, t_)
    e.updateZones()
    e.updateStructure()
    e.updatePivots()
    e.updateInternal()

// ───────────────────────────────────────────── engines ────────────────────────────────────────
int CHART_SEC = timeframe.in_seconds()
var Engine eX = f_engine(f_tfLabel(CHART_SEC), 0, CHART_SEC, swingLen)

// Higher timeframes: ONE request per timeframe. [1] + lookahead_on = the last COMPLETED candle of
// that timeframe, identical on historical and live bars (no repainting, no future data).
f_htfBar() =>
    [open[1], high[1], low[1], close[1], time[1]]

[hAo, hAh, hAl, hAc, hAt] = request.security(syminfo.tickerid, tf4H, f_htfBar(), lookahead=barmerge.lookahead_on)
[hBo, hBh, hBl, hBc, hBt] = request.security(syminfo.tickerid, tf1H, f_htfBar(), lookahead=barmerge.lookahead_on)
[hCo, hCh, hCl, hCc, hCt] = request.security(syminfo.tickerid, tf15, f_htfBar(), lookahead=barmerge.lookahead_on)

// A higher timeframe is used only if it is actually higher than the chart.
bool useA = timeframe.in_seconds(tf4H) > CHART_SEC
bool useB = timeframe.in_seconds(tf1H) > CHART_SEC
bool useC = timeframe.in_seconds(tf15) > CHART_SEC

var Engine eA = f_engine(f_tfLabel(timeframe.in_seconds(tf4H)), 3, timeframe.in_seconds(tf4H), htfLen)
var Engine eB = f_engine(f_tfLabel(timeframe.in_seconds(tf1H)), 2, timeframe.in_seconds(tf1H), htfLen)
var Engine eC = f_engine(f_tfLabel(timeframe.in_seconds(tf15)), 1, timeframe.in_seconds(tf15), htfLen)

// The same completed HTF candle is returned on every chart bar until the next one completes:
// feed each engine ONLY when that candle's open time changes, so no candle is processed twice.
var int lastAt = na
var int lastBt = na
var int lastCt = na

bool fedA = false
bool fedB = false
bool fedC = false
if barstate.isconfirmed
    if useA and not na(hAt) and (na(lastAt) or hAt != lastAt)
        lastAt := hAt, fedA := true
        eA.feed(hAo, hAh, hAl, hAc, hAt)
    if useB and not na(hBt) and (na(lastBt) or hBt != lastBt)
        lastBt := hBt, fedB := true
        eB.feed(hBo, hBh, hBl, hBc, hBt)
    if useC and not na(hCt) and (na(lastCt) or hCt != lastCt)
        lastCt := hCt, fedC := true
        eC.feed(hCo, hCh, hCl, hCc, hCt)
    eX.feed(open, high, low, close, time)



// ───────────────────────────────────────────── structure drawings (chart TF) ──────────────────
var array<line>  stLines  = array.new<line>()
var array<label> stLabels = array.new<label>()
if barstate.isconfirmed and showStruct and (eX.evBosUp or eX.evBosDn or eX.evChUp or eX.evChDn)
    bool up = eX.evBosUp or eX.evChUp
    string txt = (eX.evChUp or eX.evChDn) ? "CHoCH" : "BOS"
    color sc = color.new(up ? #089981 : #F23645, 30)
    stLines.push(line.new(eX.brkT, eX.brkLvl, time, eX.brkLvl, xloc=xloc.bar_time, color=sc, style=line.style_dashed))
    stLabels.push(label.new(time, eX.brkLvl, txt, xloc=xloc.bar_time, style=up ? label.style_label_down : label.style_label_up,
         color=color.new(color.black, 100), textcolor=sc, size=size.tiny))
    while stLines.size() > maxStructShow
        stLines.shift().delete()
        stLabels.shift().delete()

plotshape(showDisp and barstate.isconfirmed and eX.evDispUp, "Bullish displacement", shape.triangleup, location.belowbar, color.new(#089981, 35), size=size.tiny)
plotshape(showDisp and barstate.isconfirmed and eX.evDispDn, "Bearish displacement", shape.triangledown, location.abovebar, color.new(#F23645, 35), size=size.tiny)

// ───────────────────────────────────────────── liquidity ──────────────────────────────────────
// BSL = buy-side liquidity resting ABOVE highs; SSL = sell-side liquidity resting BELOW lows.
// Only meaningful pools are tracked: prior day/week, overnight, equal highs/lows, swings that
// stand out by ≥ promATR × ATR, and 15M/1H/4H swings. Tiny chart wiggles are ignored.
type Liq
    float  px
    bool   hi                // true = BSL (above), false = SSL (below)
    string kind
    int    w                 // importance: 1 chart swing · 2 15M swing / equal H-L · 3 1H/4H swing, overnight · 4 prior day/week
    int    tMade             // left end of the line
    int    nMade             // chart bar on which it became known
    bool   done    = false   // swept or taken
    bool   swept   = false   // true only for a real sweep (closed back inside)
    int    nDone   = 0
    int    nPierce = -1
    float  ext     = na      // extreme reached beyond the level

var array<Liq> liqs = array.new<Liq>()

f_addLiq(float px, bool hi, string kind, int w, int tMade, float tol, int nMade = -1) =>
    if not na(px)
        bool dup = false
        for q in liqs
            if not q.done and q.hi == hi and math.abs(q.px - px) <= tol
                dup := true
                if w > q.w
                    q.w := w, q.kind := kind
        if not dup
            liqs.push(Liq.new(px, hi, kind, w, tMade, nMade >= 0 ? nMade : bar_index))
            // keep only the 4 most recent plain chart swings per side
            if w == 1
                int cnt = 0
                for i = liqs.size() - 1 to 0
                    Liq q = liqs.get(i)
                    if q.w == 1 and q.hi == hi and not q.done
                        cnt += 1
                        if cnt > 4
                            liqs.remove(i)
                            break

f_dropKind(string kind) =>
    if liqs.size() > 0
        for i = liqs.size() - 1 to 0
            Liq q = liqs.get(i)
            if q.kind == kind and not q.done
                liqs.remove(i)

f_liqName(Liq q) =>
    (q.hi ? "BSL · " : "SSL · ") + q.kind

// prior day / prior week: last COMPLETED bar of that timeframe ([1] + lookahead_on)
[pdH, pdL, pdT] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead=barmerge.lookahead_on)
[pwH, pwL, pwT] = request.security(syminfo.tickerid, "W", [high[1], low[1], time[1]], lookahead=barmerge.lookahead_on)

bool inRTH = not na(time(timeframe.period, RTH_SESS, TZ))
bool inON  = not na(time(timeframe.period, ON_SESS, TZ))

var int   lastDT = na
var int   lastWT = na
var float onH = na
var float onL = na
var int   onT = 0
var bool  wasON = false
var float sessH = na
var float sessL = na
var int   sessT = 0
var bool  wasRTH = false
var array<float> eqHp = array.new<float>()   // recent chart swing highs (for equal highs)
var array<int>   eqHn = array.new<int>()
var array<float> eqLp = array.new<float>()
var array<int>   eqLn = array.new<int>()
var array<label> sweepMarks = array.new<label>()

// this bar's best sweep on each side (highest importance)
Liq   swB = na     // buy-side swept  → bearish reversal fuel
Liq   swS = na     // sell-side swept → bullish reversal fuel

if barstate.isconfirmed
    float atrX = nz(eX.atr, high - low)
    float tolDup = 0.05 * atrX
    // 0) levels revealed at this bar's OPEN (prior day/week from the last completed D/W candle; the
    //    overnight range that ended with the previous bar) exist before the sweep scan, so the very
    //    bar that opens the new day / the cash session can sweep them (nMade = previous bar)
    if not na(pdT) and (na(lastDT) or pdT != lastDT)
        lastDT := pdT
        f_dropKind("PDH"), f_dropKind("PDL")
        f_addLiq(pdH, true, "PDH", 4, pdT, tolDup, bar_index - 1), f_addLiq(pdL, false, "PDL", 4, pdT, tolDup, bar_index - 1)
    if showPW and not na(pwT) and (na(lastWT) or pwT != lastWT)
        lastWT := pwT
        f_dropKind("PWH"), f_dropKind("PWL")
        f_addLiq(pwH, true, "PWH", 4, pwT, tolDup, bar_index - 1), f_addLiq(pwL, false, "PWL", 4, pwT, tolDup, bar_index - 1)
    if not inON and wasON and not na(onH)
        f_dropKind("ONH"), f_dropKind("ONL")
        f_addLiq(onH, true, "ONH", 3, onT, tolDup, bar_index - 1), f_addLiq(onL, false, "ONL", 3, onT, tolDup, bar_index - 1)
    // 1) sweeps of levels that already existed before this bar
    if liqs.size() > 0
        for q in liqs
            if not q.done and q.nMade < bar_index
                bool through = q.hi ? high > q.px : low < q.px
                bool back    = q.hi ? close < q.px : close > q.px
                if q.nPierce < 0 and through
                    q.nPierce := bar_index, q.ext := q.hi ? high : low
                if q.nPierce >= 0
                    q.ext := q.hi ? math.max(q.ext, high) : math.min(q.ext, low)
                    if back
                        q.done := true, q.swept := true, q.nDone := bar_index
                        if q.hi
                            swB := na(swB) ? q : q.w > swB.w ? q : swB
                        else
                            swS := na(swS) ? q : q.w > swS.w ? q : swS
                    else if bar_index - q.nPierce >= reclaimBars - 1
                        q.done := true, q.nDone := bar_index      // taken (run), not swept
    // 2) overnight range tracking (the finished range became liquidity above, before the sweep scan)
    if inON
        if not wasON
            onH := high, onL := low, onT := time
            sessH := na, sessL := na
        else
            onH := math.max(onH, high), onL := math.min(onL, low)
    wasON := inON
    // current cash session high / low (a target, not a sweep level — it moves until the close)
    if inRTH
        if not wasRTH
            sessH := high, sessL := low, sessT := time
        else
            sessH := math.max(sessH, high), sessL := math.min(sessL, low)
    wasRTH := inRTH
    // swings: chart swings only if they stand out; higher-timeframe swings always count
    if eX.evPH
        if eX.promPH >= promATR * atrX
            f_addLiq(eX.lastPH, true, "SH", 1, eX.tPH, tolDup)
        for i = 0 to eqHp.size() - 1
            if eqHp.size() == 0
                break
            if math.abs(eqHp.get(i) - eX.lastPH) <= eqTolATR * atrX and bar_index - eqHn.get(i) >= 3
                f_addLiq(math.max(eqHp.get(i), eX.lastPH), true, "EQH", 2, eX.tPH, tolDup)
                break
        eqHp.push(eX.lastPH), eqHn.push(bar_index)
    if eX.evPL
        if eX.promPL >= promATR * atrX
            f_addLiq(eX.lastPL, false, "SL", 1, eX.tPL, tolDup)
        for i = 0 to eqLp.size() - 1
            if eqLp.size() == 0
                break
            if math.abs(eqLp.get(i) - eX.lastPL) <= eqTolATR * atrX and bar_index - eqLn.get(i) >= 3
                f_addLiq(math.min(eqLp.get(i), eX.lastPL), false, "EQL", 2, eX.tPL, tolDup)
                break
        eqLp.push(eX.lastPL), eqLn.push(bar_index)
    // forget swing highs/lows that price has traded through (they can no longer be "equal")
    if eqHp.size() > 0
        for i = eqHp.size() - 1 to 0
            if high > eqHp.get(i)
                eqHp.remove(i), eqHn.remove(i)
    if eqLp.size() > 0
        for i = eqLp.size() - 1 to 0
            if low < eqLp.get(i)
                eqLp.remove(i), eqLn.remove(i)
    while eqHp.size() > 8
        eqHp.shift(), eqHn.shift()
    while eqLp.size() > 8
        eqLp.shift(), eqLn.shift()
    if fedC and eC.evPH
        f_addLiq(eC.lastPH, true, eC.tf + " SH", 2, eC.tPH, tolDup)
    if fedC and eC.evPL
        f_addLiq(eC.lastPL, false, eC.tf + " SL", 2, eC.tPL, tolDup)
    if fedB and eB.evPH
        f_addLiq(eB.lastPH, true, eB.tf + " SH", 3, eB.tPH, tolDup)
    if fedB and eB.evPL
        f_addLiq(eB.lastPL, false, eB.tf + " SL", 3, eB.tPL, tolDup)
    if fedA and eA.evPH
        f_addLiq(eA.lastPH, true, eA.tf + " SH", 3, eA.tPH, tolDup)
    if fedA and eA.evPL
        f_addLiq(eA.lastPL, false, eA.tf + " SL", 3, eA.tPL, tolDup)
    // 3) housekeeping: finished levels fade after 36 bars; cap the list
    if liqs.size() > 0
        for i = liqs.size() - 1 to 0
            Liq q = liqs.get(i)
            if q.done and bar_index - q.nDone > 36
                liqs.remove(i)
    while liqs.size() > 60
        liqs.shift()
    // 4) sweep markers (confirmed at this bar's close)
    if showLiq
        if not na(swB)
            sweepMarks.push(label.new(bar_index, swB.ext, "✕ " + swB.kind, style=label.style_label_down,
                 color=color.new(color.black, 100), textcolor=color.new(#F7525F, 0), size=size.tiny))
        if not na(swS)
            sweepMarks.push(label.new(bar_index, swS.ext, "✕ " + swS.kind, style=label.style_label_up,
                 color=color.new(color.black, 100), textcolor=color.new(#22AB94, 0), size=size.tiny))
        while sweepMarks.size() > 8
            sweepMarks.shift().delete()


// ───────────────────────────────────────────── setups ─────────────────────────────────────────
// One state machine per side. Shorts run the SAME code as longs on mirrored prices (p → −p), so
// the two sides can never follow different rules. In "long space": the sweep takes SSL below,
// the MSS breaks an internal HIGH, the iFVG is bullish, targets sit above.
type Setup
    int    d                      // +1 long, −1 short
    int    stage   = 0            // 0 idle · 1 swept · 2 MSS · 3 PREPARE (waiting retest) · 4 in zone (waiting 1m / conflict) · 5 ENTRY READY (pending limit) · 6 in trade
    string liqKind = ""
    float  liqPx   = na           // long-space price of the swept level
    int    liqW    = 0
    float  ext     = na           // long-space sweep extreme (lowest low since the sweep)
    int    nSweep  = 0
    float  mssLvl  = na           // long-space internal high the MSS must close above
    int    tMssPiv = 0
    bool   disp    = false
    int    nMss    = 0
    Zone   z                      // the iFVG in the trade's direction, created after the sweep
    float  zTop    = na           // long-space bounds of z
    float  zBot    = na
    int    nZone   = 0
    string ctx     = ""
    float  legExt  = na           // long-space extreme of the leg after the sweep (leg high for a long)
    int    nReady  = 0
    float  entry   = na           // long-space
    float  stop    = na
    float  tp1     = na
    float  tp2     = na
    float  tp3     = na
    string tp1s    = ""
    string tp2s    = ""
    string tp3s    = ""
    int    nEnd    = -999
    string status  = ""           // last terminal status, for the dashboard
    string lastSkip = ""          // last sweep that did NOT start a setup, and why
    // trade
    int    nRetest  = 0
    float  entry0   = na          // READY entry (before any 1m refinement)
    int    tFrom1m  = 0           // precision: only 1m bars from this time on count
    int    pStep    = 0           // precision: 0 none · 1 sweep · 2 displacement · 3 MSS (+zone) · done
    float  pLvl     = na          // precision: 1m liquidity level swept
    float  pMss     = na
    bool   pDisp    = false
    bool   pMssOK   = false
    float  pTop     = na
    int    pZoneN   = 0
    int    nPrec    = 0
    array<float> legTp
    array<bool>  legOpen
    float  rGross   = 0.0         // realised, in R, averaged over the legs
    float  ptsGross = 0.0         // realised points per contract (averaged over legs)
    bool   ambThisTrade = false
    // drawings
    box    bx
    array<line>  pl
    array<label> pb
    int    nEntry   = 0           // bar that confirmed ENTRY READY
    bool   pDone    = false       // 1m confirmation complete
    string endKind  = ""          // "MISSED" / "INVALIDATED" / "" for the last ending
    float  fillPx   = na
    float  riskPlan = na          // PLANNED risk (limit → stop): the R unit, even if the fill is better
    int    tFill    = 0           // bar time of the fill (for the verification log only)
    // per-bar events (reset every bar)
    bool   evEntry = false
    bool   evPrec  = false
    bool   evFill  = false
    bool   evStart = false
    bool   evMss   = false
    bool   evIFVG  = false
    bool   evReady = false
    bool   evRetest = false
    bool   evEnd   = false

var Setup SL = Setup.new(d=1, legTp=array.new<float>(), legOpen=array.new<bool>(), pl=array.new<line>(), pb=array.new<label>())
var Setup SS = Setup.new(d=-1, legTp=array.new<float>(), legOpen=array.new<bool>(), pl=array.new<line>(), pb=array.new<label>())

// Results of every setup on the loaded history (same numbers the strategy version trades)
type Stats
    int   ready = 0
    int   trades = 0
    int   wins = 0
    float sumR = 0.0
    float winR = 0.0
    float lossR = 0.0
    float cumR = 0.0
    float peakR = 0.0
    float maxDD = 0.0
    float netUSD = 0.0
    int   missed = 0
    int   expired = 0
    int   invalid = 0
    int   noPrec = 0              // 1m looked, no confirmation
    int   noData = 0              // 1m history unavailable → excluded
    int   ambRes = 0              // stop AND target inside one chart bar, order settled by 1m bars
    int   ambUnres = 0            // …order could not be settled → stop-first
    int   first1m = 0             // first chart bar time with 1m intrabars
    int   qaChecks = 0            // QA: rule-order checks performed
    int   qaViol  = 0             // QA: rule-order violations (must stay 0)

var Stats ST = Stats.new()

bool inWin = not useWin or not na(time(timeframe.period, winSess, TZ))

// Is time t (a bar OPEN time) inside the setup window? Used for the NEXT bar (= time_close).
f_winAt(int t) =>
    int st = int(str.tonumber(str.substring(winSess, 0, 2))) * 60 + int(str.tonumber(str.substring(winSess, 2, 4)))
    int en = int(str.tonumber(str.substring(winSess, 5, 7))) * 60 + int(str.tonumber(str.substring(winSess, 7, 9)))
    int m = hour(t, TZ) * 60 + minute(t, TZ)
    not useWin or (m >= st and m < en)

f_biasTxt(int sc) =>
    sc >= 3 ? "BULLISH" : sc <= -3 ? "BEARISH" : "NEUTRAL"

// long-space helpers
f_hi(int d) => d == 1 ? high : -low
f_lo(int d) => d == 1 ? low : -high
f_cl(int d) => d * close
f_back(int d, float p) => d * p        // long-space → real price (its own inverse)

// Did the sweep extreme trade into a 15M/1H/4H zone that points the trade's way?
f_tap(Engine e, bool use, int d, float ext_, float c_) =>
    string hit = ""
    if use
        for z in e.zones
            if z.bull == (d == 1)
                float t_ = d == 1 ? z.top : -z.bot
                float b_ = d == 1 ? z.bot : -z.top
                if ext_ <= t_ and c_ >= b_ and hit == ""
                    hit := e.tf + (z.inv ? (d == 1 ? " BULL iFVG" : " BEAR iFVG") : (d == 1 ? " BULL FVG" : " BEAR FVG"))
    hit

method reset(Setup S, string why, string kind = "") =>
    if S.stage > 0
        S.status := why, S.nEnd := bar_index, S.evEnd := true, S.endKind := kind
    S.stage := 0, S.z := na, S.disp := false, S.pDone := false

// Take this bar's new chart-TF iFVG in the trade's direction (only called at/after the MSS).
method captureIFVG(Setup S, bool newInv) =>
    int d = S.d
    if newInv and not na(eX.lastIFVG) and not eX.lastIFVG.dead
        Zone zc = eX.lastIFVG
        float zt = d == 1 ? zc.top : -zc.bot
        float zb = d == 1 ? zc.bot : -zc.top
        if zb > S.ext
            S.z := zc, S.zTop := zt, S.zBot := zb, S.nZone := bar_index, S.evIFVG := true
    true

method run(Setup S) =>
    int d = S.d
    float h_ = f_hi(d)
    float l_ = f_lo(d)
    float c_ = f_cl(d)
    float atrX = nz(eX.atr, high - low)
    // this bar's sweep on the side that feeds this direction (SSL for longs, BSL for shorts)
    Liq sw = d == 1 ? swS : swB
    bool dispNow = d == 1 ? eX.evDispUp : eX.evDispDn
    bool newInv = d == 1 ? eX.evBullIFVG : eX.evBearIFVG
    // ── stage 1 / 2: after the sweep ──
    if S.stage == 1 or S.stage == 2
        float extBefore = S.ext                      // the sweep extreme as known BEFORE this candle
        S.ext := math.min(S.ext, l_)                 // a wick can extend it; only a CLOSE beyond invalidates
        S.legExt := math.max(nz(S.legExt, h_), h_)
        S.disp := S.disp or dispNow
        if c_ < S.liqPx and S.stage == 1
            S.reset("FAILED — closed back through the swept level")
        else if c_ < extBefore
            S.reset("INVALIDATED — a candle closed beyond the sweep extreme")
        else if S.stage == 1
            if c_ > S.mssLvl
                if S.disp
                    S.stage := 2, S.nMss := bar_index, S.evMss := true
                else
                    S.reset("NO DISPLACEMENT — structure broke without a displacement candle")
            else if bar_index - S.nSweep > mssWindow
                S.reset("EXPIRED — no MSS within " + str.tostring(mssWindow) + " bars")
        else if S.stage == 2 and na(S.z) and bar_index - S.nMss > ifvgWindow
            S.reset("EXPIRED — no iFVG within " + str.tostring(ifvgWindow) + " bars of the MSS")
        // the iFVG must be made AT or AFTER the MSS (the MSS candle itself may invert the FVG)
        if S.stage == 2 and na(S.z)
            S.captureIFVG(newInv)
    // ── start (or refresh while only swept) ──
    if not na(sw) and (S.stage == 0 or S.stage == 1) and setupsOn and bar_index - S.nEnd > cooldown
        float px_ = d * sw.px
        float ex_ = d * sw.ext
        // context
        int b1 = useB ? eB.bias() : 0
        int b4 = useA ? eA.bias() : 0
        bool al1 = d * b1 >= 3
        bool op1 = d * b1 <= -3
        bool al4 = d * b4 >= 3
        bool op4 = d * b4 <= -3
        string tap = f_tap(eC, useC, d, ex_, c_)
        tap := tap != "" ? tap : f_tap(eB, useB, d, ex_, c_)
        tap := tap != "" ? tap : f_tap(eA, useA, d, ex_, c_)
        bool ctxOK = ctxMode == "Off" ? true : ctxMode == "Strict" ? al1 and not op4 :
             not op1 and (al1 or al4 or tap != "" or sw.w >= 3)
        string ctxTxt = eB.tf + " " + f_biasTxt(b1) + " · " + eA.tf + " " + f_biasTxt(b4) + (tap != "" ? " · in " + tap : "")
        if not inWin
            S.lastSkip := (d == 1 ? "SSL" : "BSL") + " swept (" + sw.kind + ") outside the setup window"
        else if not ctxOK
            S.lastSkip := (d == 1 ? "SSL" : "BSL") + " swept (" + sw.kind + ") — HTF context ✗ (" + ctxTxt + ")"
        else
            // the internal high that led into the sweep: most recent confirmed one above the close
            float m_ = na
            int   mt = 0
            array<float> ip = d == 1 ? eX.ipH : eX.ipL
            array<int>   it = d == 1 ? eX.ipHt : eX.ipLt
            if ip.size() > 0
                for i = ip.size() - 1 to 0
                    float v = d * ip.get(i)
                    if v > c_ and na(m_)
                        m_ := v, mt := it.get(i)
            if na(m_) and eX.h.size() > 2
                // fallback: the highest high of the 10 bars before the sweep bar
                for j = 1 to math.min(10, eX.h.size() - 1)
                    float v = d == 1 ? eX.h.get(j) : -eX.l.get(j)
                    if na(m_) or v > m_
                        m_ := v, mt := eX.t.get(j)
            S.stage := 1, S.liqKind := sw.kind, S.liqPx := px_, S.liqW := sw.w, S.ext := ex_, S.nSweep := bar_index
            S.mssLvl := m_, S.tMssPiv := mt, S.disp := dispNow, S.z := na, S.legExt := h_, S.ctx := ctxTxt
            S.evStart := true
            // the same candle may already carry the displacement AND close above the MSS level
            if c_ > S.mssLvl and S.disp
                S.stage := 2, S.nMss := bar_index, S.evMss := true
                S.captureIFVG(newInv)
    // ── MSS + iFVG both present → candidate READY (targets decide) ──
    S.stage == 2 and not na(S.z) and not S.z.dead

// Targets in long space: real opposing liquidity and HTF zones above the entry, nearest first.
f_targets(Setup S) =>
    int d = S.d
    float R = S.entry - S.stop
    array<float> px = array.new<float>()
    array<string> nm = array.new<string>()
    if not na(S.legExt)
        px.push(S.legExt), nm.push("LEG " + (d == 1 ? "HIGH" : "LOW"))
    for q in liqs
        if not q.done and q.hi == (d == 1)
            px.push(d * q.px), nm.push(q.kind)
    if not na(sessH)
        px.push(d == 1 ? sessH : -sessL), nm.push(d == 1 ? "SESSION H" : "SESSION L")
    for e in array.from(eC, eB, eA)
        if e.n > 0 and e.rank > 0
            for z in e.zones
                if z.bull != (d == 1)
                    px.push(d == 1 ? z.bot : -z.top), nm.push(e.tf + (z.inv ? (d == 1 ? " BEAR iFVG" : " BULL iFVG") : (d == 1 ? " BEAR FVG" : " BULL FVG")))
    array<int> ord = px.sort_indices(order.ascending)
    array<float> tp = array.new<float>()
    array<string> tn = array.new<string>()
    for k = 0 to ord.size() - 1
        if ord.size() == 0
            break
        float v = px.get(ord.get(k))
        if v >= S.entry + minTgtR * R and (tp.size() == 0 or v - tp.last() >= 0.25 * R) and tp.size() < 3
            tp.push(v), tn.push(nm.get(ord.get(k)))
    S.tp1 := tp.size() > 0 ? tp.get(0) : na
    S.tp2 := tp.size() > 1 ? tp.get(1) : na
    S.tp3 := tp.size() > 2 ? tp.get(2) : na
    S.tp1s := tn.size() > 0 ? tn.get(0) : ""
    S.tp2s := tn.size() > 1 ? tn.get(1) : ""
    S.tp3s := tn.size() > 2 ? tn.get(2) : ""

method armPlan(Setup S, float atrX) =>
    S.entry := entryRef == "Zone edge" ? S.zTop : (S.zTop + S.zBot) / 2
    // stop beyond the sweep, rounded OUTWARD to a valid tick (in long space floor = further away for both sides)
    S.stop := math.floor((S.ext - math.max(stopBufATR * atrX, 2 * TICK)) / TICK + 1e-9) * TICK
    if S.entry - S.stop < 2 * TICK
        S.reset("SKIPPED — risk too small")
    else
        f_targets(S)
        if na(S.tp1)
            S.reset("SKIPPED — no opposing liquidity target ≥ " + str.tostring(minTgtR) + "R")
        else
            S.stage := 3, S.nReady := bar_index, S.evReady := true, S.entry0 := S.entry, S.pDone := false
    true

method arm(Setup S) =>
    float atrX = nz(eX.atr, high - low)
    if not inWin
        S.reset("Setup window closed before PREPARE")
    else
        S.armPlan(atrX)
    true


// ───────────────────────────────────────────── trade tracking ─────────────────────────────────
// The chart bar's own 1-minute bars (empty where TradingView holds no 1m history for that date).
// Used for (a) precision mode and (b) settling which of stop / target came first inside a bar.
[m1o, m1h, m1l, m1c, m1t] = request.security_lower_tf(syminfo.tickerid, timeframe.in_seconds() > 60 ? "1" : timeframe.period, [open, high, low, close, time])
bool LTF_OK = CHART_SEC > 60
bool HAS_1M = LTF_OK and m1h.size() > 0
var Engine e1 = f_engine("1M", -1, 60, 2)
bool inFlat = not na(time(timeframe.period, flatSess, TZ))

// Both sides holding an actionable setup (PREPARE / in zone / ENTRY READY) = conflict → nothing fills.
f_actionable(Setup S) =>
    S.stage >= 3 and S.stage <= 5
var bool conflictPrev = false          // conflict as of the PREVIOUS close (what a pending order knew)
var bool tradePrev = false             // a position (either side) was open at the previous close — one position at a time

method exitLeg(Setup S, int i, float px) =>
    int nL = S.legTp.size()
    S.legOpen.set(i, false)
    S.ptsGross += (px - S.fillPx) / nL
    S.rGross += (px - S.fillPx) / S.riskPlan / nL

method exitAll(Setup S, float px) =>
    if S.legOpen.size() > 0
        for i = 0 to S.legOpen.size() - 1
            if S.legOpen.get(i)
                S.exitLeg(i, px)

method openLegs(Setup S) =>
    int n = 0
    for b in S.legOpen
        n += b ? 1 : 0
    n

// Net result per contract after this instrument's fees; feeds the results table.
method closeTrade(Setup S, Stats T, string why) =>
    float netR = S.rGross - 2 * FEE_SIDE / syminfo.pointvalue / S.riskPlan
    T.trades += 1
    T.wins += netR > 0 ? 1 : 0
    T.sumR += netR
    if netR > 0
        T.winR += netR
    else
        T.lossR += netR
    T.cumR += netR
    T.peakR := math.max(T.peakR, T.cumR)
    T.maxDD := math.max(T.maxDD, T.peakR - T.cumR)
    T.netUSD += (S.ptsGross * syminfo.pointvalue - 2 * FEE_SIDE) * qtyC
    // verification log (Pine Logs panel) — compare with the strategy's "TV" lines
    log.info("CORE {0} {1} fill {2} exit {3} · gross {4} pts · net {5}R · {6}", str.format_time(S.tFill, "yyyy-MM-dd HH:mm", TZ),
         S.d == 1 ? "LONG" : "SHORT", f_px(S.d * S.fillPx), why, str.tostring(S.ptsGross * S.d * S.d, "#.##"), str.tostring(netR, "#.###"), "fees $" + str.tostring(2 * FEE_SIDE, "#.00") + "/RT")
    S.reset(why + " " + (netR >= 0 ? "+" : "") + str.tostring(netR, "#.##") + "R net")

// Precision: 1m bars from the first touch of the zone on — sweep → displacement → MSS → FVG/iFVG →
// retest. It may complete INSIDE the 5m retest candle, but it only counts once that 5m candle has
// closed holding the zone (the caller enforces that).
method precStep(Setup S, int k) =>
    if S.stage == 4 and not S.pDone and m1t.get(k) >= S.tFrom1m
        int d = S.d
        float sl = d == 1 ? m1l.get(k) : -m1h.get(k)
        float sc = d * m1c.get(k)
        // 1) 1m liquidity sweep: through the lowest low of the previous 10 one-minute bars, close back above
        float lv = na
        for j = 1 to math.min(10, e1.l.size() - 1)
            if e1.l.size() < 2
                break
            float v = d == 1 ? e1.l.get(j) : -e1.h.get(j)
            lv := na(lv) ? v : math.min(lv, v)
        if not na(lv) and sl < lv and sc > lv and not S.pMssOK
            S.pStep := 1, S.pLvl := lv, S.pDisp := false, S.pTop := na
            float m_ = na
            array<float> ip = d == 1 ? e1.ipH : e1.ipL
            if ip.size() > 0
                for i = ip.size() - 1 to 0
                    float v = d * ip.get(i)
                    if v > sc and na(m_)
                        m_ := v
            if na(m_) and e1.h.size() > 2
                for j = 1 to math.min(5, e1.h.size() - 1)
                    float v = d == 1 ? e1.h.get(j) : -e1.l.get(j)
                    m_ := na(m_) ? v : math.max(m_, v)
            S.pMss := m_
        if S.pStep >= 1
            // 2) displacement
            S.pDisp := S.pDisp or (d == 1 ? e1.evDispUp : e1.evDispDn)
            if S.pDisp
                S.pStep := math.max(S.pStep, 2)
                // 3) MSS
                if not S.pMssOK and not na(S.pMss) and sc > S.pMss
                    S.pMssOK := true, S.pStep := 3
                // 4) a 1m FVG or iFVG in the trade's direction, made at/after the displacement
                if (d == 1 ? e1.evBullIFVG : e1.evBearIFVG) and not na(e1.lastIFVG)
                    S.pTop := d == 1 ? e1.lastIFVG.top : -e1.lastIFVG.bot, S.pZoneN := e1.n
                else if (d == 1 ? e1.evBullFVG : e1.evBearFVG) and e1.zones.size() > 0
                    Zone zz = e1.zones.last()
                    S.pTop := d == 1 ? zz.top : -zz.bot, S.pZoneN := e1.n
                if not na(S.pTop)
                    S.pStep := math.max(S.pStep, 4)
            // 5) retest of that 1m zone on a LATER 1m bar
            if S.pMssOK and not na(S.pTop) and e1.n > S.pZoneN and sl <= S.pTop
                S.pDone := true, S.pStep := 5
    true

// Fills (pending ENTRY READY limit) and exits. Inside a bar the order of events is replayed on its
// 1m bars when TradingView has them; otherwise (or inside one 1m bar) stop + target = stop first.
method manage(Setup S, Stats T) =>
    int d = S.d
    bool fillable = S.stage == 5 and bar_index > S.nEntry and not conflictPrev and not tradePrev and inWin
    if fillable or S.stage == 6
        float h_ = f_hi(d)
        float l_ = f_lo(d)
        int nSub = HAS_1M ? m1h.size() : 0
        bool exact = nSub > 0
        bool bothIn = false
        if S.stage == 6
            for [i, tpv] in S.legTp
                if S.legOpen.get(i) and l_ <= S.stop and h_ >= tpv + TICK
                    bothIn := true
        int unres0 = T.ambUnres
        string why = ""
        for k = 0 to (exact ? nSub : 1) - 1
            float sh = exact ? (d == 1 ? m1h.get(k) : -m1l.get(k)) : h_
            float sl = exact ? (d == 1 ? m1l.get(k) : -m1h.get(k)) : l_
            float so = exact ? d * m1o.get(k) : d * open
            if S.stage != 6
                if sl <= S.entry - TICK            // a limit fills only on a 1-tick trade-through
                    // already through the limit at the open → fills at the open (better), like the broker
                    S.riskPlan := S.entry - S.stop
                    S.stage := 6, S.evFill := true, S.fillPx := k == 0 and so < S.entry ? so : S.entry, S.tFill := time
                    S.legTp.clear(), S.legOpen.clear()
                    float t1 = S.tp1
                    float t2 = nz(S.tp2, t1)
                    float t3 = nz(S.tp3, t2)
                    if exitPlan == "TP1"
                        S.legTp.push(t1)
                    else if exitPlan == "TP2"
                        S.legTp.push(t2)
                    else
                        S.legTp.push(t1), S.legTp.push(t2), S.legTp.push(t3)
                    for tpv in S.legTp
                        S.legOpen.push(true)
                    S.rGross := 0.0, S.ptsGross := 0.0
                    // stop on the fill bar is exact (price must pass the entry to reach it);
                    // a target touched in that same bar is NOT credited (order unknown)
                    if sl <= S.stop
                        S.exitAll(math.min(S.stop - stopSlip * TICK, so)), why := "✗ STOP"
                    else
                        for tpv in S.legTp
                            if sh >= tpv + TICK
                                T.ambUnres += 1
                                break
            else
                bool hitS = sl <= S.stop
                bool hitT = false
                for [i, tpv] in S.legTp
                    if S.legOpen.get(i) and sh >= tpv + TICK
                        hitT := true
                if hitS
                    if hitT
                        T.ambUnres += 1
                    S.exitAll(math.min(S.stop - stopSlip * TICK, so)), why := "✗ STOP"
                else if hitT
                    for [i, tpv] in S.legTp
                        if S.legOpen.get(i) and sh >= tpv + TICK
                            S.exitLeg(i, tpv)
                    why := "✓ TARGET"
            if S.stage == 6 and S.openLegs() == 0
                break
        if bothIn and exact and T.ambUnres == unres0
            T.ambRes += 1
        if S.stage == 6 and S.openLegs() > 0 and not inFlat
            S.exitAll(f_cl(d)), why := "FLAT at session end"
        if S.stage == 6 and S.openLegs() == 0
            S.closeTrade(T, why)
    true

// Close-based checks shared by stages 3–5 (before any fill). Returns true if the setup ended.
method preEntryChecks(Setup S, Stats T, bool hFlip) =>
    int d = S.d
    float c_ = f_cl(d)
    bool ended = false
    if c_ < S.ext
        T.invalid += 1, S.reset("INVALIDATED — a candle closed beyond the sweep extreme", "INVALIDATED"), ended := true
    else if S.z.dead or c_ < S.zBot
        T.invalid += 1, S.reset("INVALIDATED — a candle closed through the iFVG", "INVALIDATED"), ended := true
    else if hFlip
        T.invalid += 1, S.reset("INVALIDATED — a completed 1H candle flipped the 1H bias against the trade", "INVALIDATED"), ended := true
    ended

// Stage 3 → 4/5 at the retest candle's CLOSE (zone held). Also PREPARE-stage misses and expiries.
method onClosePrepare(Setup S, Stats T, bool hFlip) =>
    if S.stage == 3 and bar_index > S.nReady
        int d = S.d
        float h_ = f_hi(d)
        float l_ = f_lo(d)
        if not S.preEntryChecks(T, hFlip)
            if l_ <= S.zTop
                // the retest candle has closed and the zone held
                S.stage := 4, S.evRetest := true, S.nRetest := bar_index, S.tFrom1m := time
                S.pStep := 0, S.pDisp := false, S.pMssOK := false, S.pTop := na, S.pDone := false
                if HAS_1M
                    for k = 0 to m1h.size() - 1
                        if (d == 1 ? m1l.get(k) : -m1h.get(k)) <= S.zTop
                            S.tFrom1m := m1t.get(k)
                            break
            else if h_ >= S.tp1
                T.missed += 1, S.reset("MISSED — ran to TP1 without retracing into the iFVG", "MISSED")
            else if bar_index - S.nReady > readyWindow
                T.expired += 1, S.reset("PREPARE expired — no retest in " + str.tostring(readyWindow) + " bars")
            else if not inWin
                T.expired += 1, S.reset("PREPARE expired — setup window closed")
    true

// Stage 4 → 5 once every enabled requirement has CLOSED and confirmed; otherwise wait / cancel.
method onCloseZone(Setup S, Stats T, bool hFlip, bool otherActive) =>
    if S.stage == 4
        int d = S.d
        float c_ = f_cl(d)
        float R = S.entry0 - S.stop
        if not S.preEntryChecks(T, hFlip)
            if c_ >= S.entry0 + chaseR * R
                T.missed += 1, S.reset("MISSED — price left the zone before the entry was confirmed", "MISSED")
            else if precOn and not HAS_1M
                T.noData += 1, S.reset("1M DATA UNAVAILABLE — excluded from results (not a failed confirmation)")
            else if precOn and not S.pDone and bar_index - S.nRetest >= precBars
                T.noPrec += 1, S.reset("INVALIDATED — no 1-minute confirmation within " + str.tostring(precBars) + " bars", "INVALIDATED")
            else if not inWin
                T.expired += 1, S.reset("Setup window closed before confirmation")
            else if not f_winAt(time_close)
                T.expired += 1, S.reset("Setup window closes at the next bar — no entry")
            else if (not precOn or S.pDone) and not otherActive
                // ENTRY READY: limit at the entry price for pendBars bars
                float e_ = S.entry0
                if precOn and not na(S.pTop) and S.pTop > S.stop and S.pTop <= S.zTop
                    e_ := S.pTop
                S.entry := e_, S.stage := 5, S.nEntry := bar_index, S.evEntry := true
    true

// Stage 5: pending limit that did not fill this bar.
method onClosePending(Setup S, Stats T, bool hFlip) =>
    if S.stage == 5 and bar_index > S.nEntry
        int d = S.d
        float c_ = f_cl(d)
        float R = S.entry - S.stop
        if not S.preEntryChecks(T, hFlip)
            if c_ >= S.entry + chaseR * R
                T.missed += 1, S.reset("MISSED — price ran " + str.tostring(chaseR) + "R past the entry without a fill", "MISSED")
            else if bar_index - S.nEntry >= pendBars
                T.missed += 1, S.reset("MISSED — limit not filled within " + str.tostring(pendBars) + " bars (cancelled)", "MISSED")
            else if not inWin or not f_winAt(time_close)
                T.invalid += 1, S.reset("INVALIDATED — setup window closed (cancel the order)", "INVALIDATED")
    true

// ───────────────────────────────────────────── plan drawings ──────────────────────────────────
var array<box>   planBoxes  = array.new<box>()
var array<line>  planLines  = array.new<line>()
var array<label> planLabels = array.new<label>()

f_keep() =>
    while planBoxes.size() > 6
        planBoxes.shift().delete()
    while planLines.size() > 48
        planLines.shift().delete()
    while planLabels.size() > 60
        planLabels.shift().delete()

method planLine(Setup S, float pLong, string txt, color col, string sty, int t0, int t1) =>
    float real = S.d * pLong
    float R = S.entry - S.stop
    line ln = line.new(t0, real, t1, real, xloc=xloc.bar_time, color=col, style=sty, width=1)
    string rr = pLong > S.entry ? " · " + str.tostring((pLong - S.entry) / R, "#.#") + "R" : ""
    // labels sit just right of the setup candle (not at the far end, which hides under the dashboard / off-screen)
    label lb = label.new(t0 + 2 * CHART_SEC * 1000, real, txt + " " + f_px(real) + rr, xloc=xloc.bar_time, style=label.style_label_left,
         color=color.new(color.black, 100), textcolor=col, size=size.tiny)
    S.pl.push(ln), S.pb.push(lb), planLines.push(ln), planLabels.push(lb)

method drawPlan(Setup S, string head) =>
    S.pl.clear(), S.pb.clear()
    if showPlan
        int t0 = time
        int t1 = time + readyWindow * CHART_SEC * 1000
        color cz = S.d == 1 ? cBullInv : cBearInv
        float zt = S.d == 1 ? S.zTop : -S.zBot
        float zb = S.d == 1 ? S.zBot : -S.zTop
        S.bx := box.new(t0, zt, t1, zb, xloc=xloc.bar_time, border_color=color.new(cz, 0), border_width=1,
             bgcolor=color.new(cz, 78), text=head, text_size=size.tiny,
             text_color=color.new(cz, 0), text_halign=text.align_left, text_valign=text.align_top)
        planBoxes.push(S.bx)
        S.planLine(S.entry, "ENTRY", color.new(color.white, 15), line.style_solid, t0, t1)
        S.planLine(S.stop, "STOP · beyond " + S.liqKind + " sweep", color.new(#F23645, 0), line.style_solid, t0, t1)
        color tc = color.new(#089981, 0)
        if not na(S.tp1)
            S.planLine(S.tp1, "TP1 · " + S.tp1s, tc, line.style_dashed, t0, t1)
        if not na(S.tp2)
            S.planLine(S.tp2, "TP2 · " + S.tp2s, tc, line.style_dashed, t0, t1)
        if not na(S.tp3)
            S.planLine(S.tp3, "TP3 · " + S.tp3s, tc, line.style_dashed, t0, t1)
        f_keep()
    true

method endPlan(Setup S) =>
    if showPlan and not na(S.bx)
        S.bx.set_right(time)
        for ln in S.pl
            ln.set_x2(time)
        bool good = str.startswith(S.status, "✓")
        bool bad = str.startswith(S.status, "✗") or S.endKind == "INVALIDATED"
        color oc = good ? #089981 : bad ? #F23645 : color.gray
        planLabels.push(label.new(time, S.d * S.entry, S.status, xloc=xloc.bar_time,
             style=S.d == 1 ? label.style_label_up : label.style_label_down, color=color.new(oc, 20), textcolor=color.white, size=size.tiny))
        S.bx := na
        f_keep()
    true

f_mark(Setup S, float pLong, string txt, color col) =>
    if showPlan
        planLabels.push(label.new(time, S.d * pLong, txt, xloc=xloc.bar_time, style=S.d == 1 ? label.style_label_down : label.style_label_up,
             color=color.new(color.black, 100), textcolor=col, size=size.tiny))
        f_keep()

// ───────────────────────────────────────────── per-bar driver ─────────────────────────────────
// Order inside one closed bar: fills/exits (intrabar) → retest close → 1m replay → zone close →
// pending close → new setups → conflict state for the NEXT bar.
if barstate.isconfirmed
    // a 1H bias flip counts only when a COMPLETED 1H candle confirms it
    bool flipL = fedB and ctxMode != "Off" and eB.bias() <= -3
    bool flipS = fedB and ctxMode != "Off" and eB.bias() >= 3
    for S in array.from(SL, SS)
        S.evStart := false, S.evMss := false, S.evIFVG := false, S.evReady := false, S.evRetest := false
        S.evEnd := false, S.evPrec := false, S.evFill := false, S.evEntry := false
        S.manage(ST)
    SL.onClosePrepare(ST, flipL)
    SS.onClosePrepare(ST, flipS)
    if HAS_1M
        if ST.first1m == 0
            ST.first1m := time
        if precOn
            for k = 0 to m1h.size() - 1
                e1.feed(m1o.get(k), m1h.get(k), m1l.get(k), m1c.get(k), m1t.get(k))
                SL.precStep(k)
                SS.precStep(k)
    SL.onCloseZone(ST, flipL, f_actionable(SS))
    SS.onCloseZone(ST, flipS, f_actionable(SL))
    SL.onClosePending(ST, flipL)
    SS.onClosePending(ST, flipS)
    for S in array.from(SL, SS)
        bool flip = S.d == 1 ? flipL : flipS
        if flip and (S.stage == 1 or S.stage == 2)
            S.reset("1H bias flipped against the setup")
        if S.evEnd
            S.endPlan()
        bool cand = S.run()
        if cand
            S.arm()
            if S.evReady
                ST.ready += 1
                S.drawPlan((S.d == 1 ? "PREPARE LONG" : "PREPARE SHORT") + " · entry zone")
        color dc = S.d == 1 ? #089981 : #F23645
        if S.evMss
            f_mark(S, S.mssLvl, "MSS", dc)
        if S.evRetest
            f_mark(S, S.zBot, "RETEST ✓ (closed, zone held)", dc)
        if S.evEntry
            f_mark(S, S.entry, "ENTRY READY", dc)
    conflictPrev := f_actionable(SL) and f_actionable(SS)
    tradePrev := SL.stage == 6 or SS.stage == 6



// ───────────────────────────────────────────── ACTION RIGHT NOW ───────────────────────────────
// Decided on CLOSED bars only. Exactly one of: WAIT · PREPARE LONG/SHORT · ENTRY READY — LONG/SHORT ·
// MISSED — DO NOT CHASE · INVALIDATED — CANCEL ORDER. Conflicting sides → WAIT.
f_side(int d) =>
    d == 1 ? "LONG" : "SHORT"

f_real(Setup S, float pLong) =>
    f_px(S.d * pLong)

f_zoneTxt(Setup S) =>
    f_px(math.min(S.d * S.zTop, S.d * S.zBot)) + "–" + f_px(math.max(S.d * S.zTop, S.d * S.zBot))

f_liqWord(Setup S) =>
    S.d == 1 ? "Sell-side liquidity (SSL)" : "Buy-side liquidity (BSL)"

f_actOf(Setup S) =>
    S.stage == 5 ? "ENTRY READY — " + f_side(S.d) : S.stage == 3 ? "PREPARE " + f_side(S.d) :
         S.stage == 0 and S.endKind == "MISSED" and bar_index - S.nEnd <= 3 ? "MISSED — DO NOT CHASE" :
         S.stage == 0 and S.endKind == "INVALIDATED" and bar_index - S.nEnd <= 3 ? "INVALIDATED — CANCEL ORDER" : "WAIT"

f_rank(string a) =>
    str.startswith(a, "ENTRY") ? 4 : str.startswith(a, "PREPARE") ? 3 : a != "WAIT" ? 2 : 0

// Plain-English "what happened / what's missing" for one side.
f_explain(Setup S) =>
    string L = f_liqWord(S)
    string up = S.d == 1 ? "bullish" : "bearish"
    string beyond = S.d == 1 ? "below" : "above"
    string s_ = ""
    if S.stage == 1
        s_ := L + " swept at " + S.liqKind + " " + f_real(S, S.liqPx) + " ✓ (traded " + beyond + " it and closed back)." +
             (S.disp ? "\n" + str.upper(up) + " displacement ✓" : "\nNo " + up + " displacement yet.") +
             "\nWaiting for a confirmed 5-minute " + up + " MSS: a candle CLOSE " + (S.d == 1 ? "above " : "below ") + f_real(S, S.mssLvl) + "."
    else if S.stage == 2
        s_ := L + " swept ✓\n" + str.upper(up) + " displacement ✓\n" + str.upper(up) + " MSS ✓\nWaiting for a " +
             (S.d == 1 ? "bearish" : "bullish") + " FVG to be closed through (it becomes the " + up + " iFVG)."
    else if S.stage == 3
        s_ := L + " swept ✓\n" + str.upper(up) + " displacement ✓\n" + str.upper(up) + " MSS ✓\n" + str.upper(up) + " iFVG created ✓ " + f_zoneTxt(S) +
             "\nWaiting for price to retrace INTO the iFVG and a 5-minute candle to CLOSE holding it."
    else if S.stage == 4
        s_ := "Price retested the 5-minute entry zone " + f_zoneTxt(S) + " and the candle closed holding it ✓" +
             (precOn ? "\nWaiting for confirmed 1-minute " + up + " structure (sweep → displacement → MSS → FVG → retest)." : "\nWaiting — the other side also has a live setup.")
    else if S.stage == 5
        s_ := "Every enabled condition has closed and confirmed.\nLimit " + (S.d == 1 ? "buy" : "sell") + " at " + f_real(S, S.entry) + ", valid " + str.tostring(pendBars) +
             " bars. Cancel if a 5-minute candle closes " + (S.d == 1 ? "below " : "above ") + f_real(S, math.max(S.ext, S.zBot)) + "."
    else if S.stage == 6
        s_ := "Entry filled at " + f_real(S, S.fillPx) + " (as modelled). Stop " + f_real(S, S.stop) + " · TP1 " + f_real(S, S.tp1) + ". Manage your position."
    else
        s_ := S.status
    s_


// When the setup window next opens (ET), for the outside-window message.
f_resume() =>
    int st = int(str.tonumber(str.substring(winSess, 0, 2))) * 60 + int(str.tonumber(str.substring(winSess, 2, 4)))
    int now = hour(time_close, TZ) * 60 + minute(time_close, TZ)
    int dw = dayofweek(time_close, TZ)            // 1 = Sunday … 7 = Saturday
    int add = now < st ? 0 : 1
    int nd = (dw - 1 + add) % 7 + 1               // weekday of the candidate day
    add += nd == 7 ? 2 : nd == 1 ? 1 : 0          // skip Saturday / Sunday
    int mins = add * 1440 + st - now
    string dayTxt = add == 0 ? "today" : add == 1 ? "tomorrow" : "Monday"
    dayTxt + " " + str.substring(winSess, 0, 2) + ":" + str.substring(winSess, 2, 4) + " ET (in " + str.tostring(math.floor(mins / 60)) + "h " + str.tostring(mins % 60) + "m)"

var string actNow = "WAIT"
var string actWhy = "No setup in progress."
var int    actSide = 0             // +1 / -1 side the action refers to, 0 none

f_alertTxt(Setup S, string act) =>
    string up = S.d == 1 ? "bullish" : "bearish"
    string m = INS + " — " + eX.tf + " " + act + " | " + (S.d == 1 ? "SSL" : "BSL") + " swept (" + S.liqKind + " " + f_real(S, S.liqPx) + ")"
    if S.stage >= 3 or str.startswith(act, "MISSED") or str.startswith(act, "INVALIDATED")
        m += " | " + up + " MSS ✓ | " + up + " iFVG " + f_zoneTxt(S)
    if S.stage == 5
        m += " | entry " + f_real(S, S.entry) + " · stop " + f_real(S, S.stop) + " · TP1 " + f_real(S, S.tp1) + " (" + S.tp1s + ", " +
             str.tostring((S.tp1 - S.entry) / (S.entry - S.stop), "#.#") + "R)"
    else if S.stage == 3
        m += " | waiting for the retest"
    else
        m += " | " + S.status
    m

if barstate.isconfirmed
    bool conf = f_actionable(SL) and f_actionable(SS)
    string aL = f_actOf(SL)
    string aS = f_actOf(SS)
    string newAct = "WAIT"
    int newSide = 0
    string why = ""
    if conf
        newAct := "WAIT", why := "Conflicting long and short setups.\nWait until one side invalidates or the higher-timeframe context resolves it."
    else
        newSide := f_rank(aL) > f_rank(aS) ? 1 : f_rank(aS) > f_rank(aL) ? -1 : SL.stage > SS.stage ? 1 : SS.stage > SL.stage ? -1 : SL.nEnd >= SS.nEnd ? 1 : -1
        Setup F = newSide == 1 ? SL : SS
        newAct := newSide == 1 ? aL : aS
        why := F.stage > 0 or bar_index - F.nEnd <= 3 ? f_explain(F) : "No setup in progress. Waiting for a qualified liquidity sweep" + (useWin ? " inside " + winSess + " ET." : ".")
        if F.stage == 0 and bar_index - F.nEnd > 3
            newSide := 0
    // nothing in progress and outside the window → say so, and when scanning resumes
    if not conf and useWin and not inWin and SL.stage == 0 and SS.stage == 0 and newAct == "WAIT"
        newAct := "WAIT — OUTSIDE SETUP WINDOW"
        why := "New setups are only scanned " + str.substring(winSess, 0, 2) + ":" + str.substring(winSess, 2, 4) + "–" + str.substring(winSess, 5, 7) + ":" + str.substring(winSess, 7, 9) + " ET.\nScanning resumes " + f_resume() + "."
    if alertsOn and alAction and newAct != actNow and not str.startswith(newAct, "WAIT")
        Setup F2 = newSide == -1 ? SS : SL
        alert(f_alertTxt(F2, newAct), alert.freq_once_per_bar_close)
    actNow := newAct, actWhy := why, actSide := newSide
    // event alerts
    if alertsOn
        if alSweep and not na(swS) and swS.w >= 3
            alert(INS + " — SSL swept: " + swS.kind + " " + f_px(swS.px) + " (traded below, closed back above)", alert.freq_once_per_bar_close)
        if alSweep and not na(swB) and swB.w >= 3
            alert(INS + " — BSL swept: " + swB.kind + " " + f_px(swB.px) + " (traded above, closed back below)", alert.freq_once_per_bar_close)
        if alIFVG and eX.evBullIFVG
            alert(INS + " — " + eX.tf + " bullish iFVG created " + f_px(eX.lastIFVG.bot) + "–" + f_px(eX.lastIFVG.top), alert.freq_once_per_bar_close)
        if alIFVG and eX.evBearIFVG
            alert(INS + " — " + eX.tf + " bearish iFVG created " + f_px(eX.lastIFVG.bot) + "–" + f_px(eX.lastIFVG.top), alert.freq_once_per_bar_close)
        for S in array.from(SL, SS)
            if alMss and S.evMss
                alert(INS + " — " + eX.tf + " " + (S.d == 1 ? "bullish" : "bearish") + " MSS confirmed after " + (S.d == 1 ? "SSL" : "BSL") + " sweep (" + S.liqKind + ")", alert.freq_once_per_bar_close)
            if alRetest and S.evRetest
                alert(INS + " — " + eX.tf + " " + f_side(S.d) + " RETEST: candle closed holding the iFVG " + f_zoneTxt(S), alert.freq_once_per_bar_close)

// QA: log setup events and check that every step happened on or after the CLOSED candle it needs.
method qaCheck(Setup S, Stats T) =>
    if qaLog
        int d = S.d
        string sd = d == 1 ? "LONG" : "SHORT"
        string ts = str.format_time(time, "yyyy-MM-dd HH:mm", TZ)
        float l_ = f_lo(d)
        float c_ = f_cl(d)
        if S.evReady
            T.qaChecks += 1
            bool ok = S.nMss >= S.nSweep and S.nZone >= S.nMss and S.entry > S.stop and S.zBot > S.stop
            T.qaViol += ok ? 0 : 1
            log.info("QA PREPARE {0} {1} · sweep bar {2} · MSS bar {3} · iFVG bar {4} · zone {5}", sd, ts, str.tostring(S.nSweep), str.tostring(S.nMss), str.tostring(S.nZone), f_zoneTxt(S))
            if not ok
                log.error("QA VIOLATION PREPARE order/levels {0} {1}", sd, ts)
        if S.evRetest
            T.qaChecks += 1
            bool ok = bar_index > S.nReady and l_ <= S.zTop and c_ >= S.zBot
            T.qaViol += ok ? 0 : 1
            log.info("QA RETEST {0} {1} · low reached zone and the candle CLOSED holding it", sd, ts)
            if not ok
                log.error("QA VIOLATION RETEST {0} {1}", sd, ts)
        if S.evEntry
            T.qaChecks += 1
            bool ok = S.nRetest > S.nReady and bar_index >= S.nRetest and (not precOn or S.pDone) and inWin
            T.qaViol += ok ? 0 : 1
            log.info("QA ENTRY READY {0} {1} · entry {2} stop {3}", sd, ts, f_real(S, S.entry), f_real(S, S.stop))
            if not ok
                log.error("QA VIOLATION ENTRY READY {0} {1}", sd, ts)
        if S.evFill
            T.qaChecks += 1
            bool ok = bar_index > S.nEntry
            T.qaViol += ok ? 0 : 1
            if not ok
                log.error("QA VIOLATION FILL {0} {1}", sd, ts)
        if S.evEnd and S.status != ""
            log.info("QA END {0} {1} · {2}", sd, ts, S.status)
    true

if barstate.isconfirmed and qaLog
    SL.qaCheck(ST)
    SS.qaCheck(ST)

// ───────────────────────────────────────────── dashboard (last bar) ───────────────────────────
f_pos() =>
    dashPos == "Top left" ? position.top_left : dashPos == "Bottom right" ? position.bottom_right :
         dashPos == "Bottom left" ? position.bottom_left : dashPos == "Middle right" ? position.middle_right : position.top_right

var table DT = table.new(f_pos(), 3, 44, bgcolor=color.new(#131722, 0), border_color=color.new(#363A45, 0), border_width=1, frame_color=color.new(#363A45, 0), frame_width=1)

f_ts() =>
    dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small

// word-wrap: keep existing line breaks, break other lines at spaces so none exceeds `maxc` characters
f_wrap(string txt, int maxc) =>
    string out = ""
    array<string> paras = str.split(txt, "\n")
    for [pi, para] in paras
        array<string> words = str.split(para, " ")
        string line = ""
        for w in words
            if str.length(line) > 0 and str.length(line) + 1 + str.length(w) > maxc
                out += line + "\n"
                line := w
            else
                line := str.length(line) > 0 ? line + " " + w : w
        out += line + (pi < paras.size() - 1 ? "\n" : "")
    out

f_cell(int c, int r, string txt, color fg, color bg = na, bool merge = false, string sz = "", string ha = text.align_left) =>
    // long sentences are wrapped so the table stays narrow instead of widening over the chart
    table.cell(DT, c, r, f_wrap(txt, merge ? dashWrap : math.round(dashWrap * 0.45)), text_color=fg,
         bgcolor=na(bg) ? color.new(#131722, 0) : bg, text_size=sz == "" ? f_ts() : sz, text_halign=ha)
    if merge
        table.merge_cells(DT, c, r, 2, r)

C_TXT  = color.new(#D1D4DC, 0)
C_DIM  = color.new(#787B86, 0)
C_OK   = color.new(#22AB94, 0)
C_BAD  = color.new(#F7525F, 0)
C_HEAD = color.new(#2A2E39, 0)

f_biasCell(int sc, int d) =>
    string b = f_biasTxt(sc)
    (d * sc >= 3 ? "✓ " : d * sc <= -3 ? "✗ " : "– ") + b + " (" + (sc > 0 ? "+" : "") + str.tostring(sc) + ")"

f_loc15(int d, Setup S) =>
    string r = "–"
    if useC and eC.n > 0
        bool trendOK = d * eC.trend > 0
        string tap = S.stage > 0 ? f_tap(eC, true, d, S.ext, f_cl(d)) : ""
        bool disc = not na(eC.lastPH) and not na(eC.lastPL) and (d == 1 ? close < (eC.lastPH + eC.lastPL) / 2 : close > (eC.lastPH + eC.lastPL) / 2)
        r := trendOK or tap != "" or disc ? "✓ " + (tap != "" ? "in " + tap : trendOK ? "15M structure agrees" : d == 1 ? "discount half" : "premium half") : "✗ against 15M"
    r

f_chk(Setup S, int row) =>
    // row: 0 sweep · 1 displacement · 2 MSS · 3 iFVG · 4 retest · 5 1m
    string r = "–"
    int st = S.stage
    if row == 0
        r := st >= 1 ? "✓ " + S.liqKind : "WAITING"
    else if row == 1
        r := st >= 1 ? (S.disp or st >= 2 ? "✓" : "WAITING") : "–"
    else if row == 2
        r := st >= 2 ? "✓" : st == 1 ? "WAITING" : "–"
    else if row == 3
        r := st >= 3 ? "✓ " + f_zoneTxt(S) : st == 2 ? "WAITING" : "–"
    else if row == 4
        r := st >= 4 ? "✓ closed, held" : st == 3 ? "WAITING" : "–"
    else
        r := not precOn ? "OFF" : st >= 5 ? "✓" : st == 4 ? (S.pDone ? "✓" : "WAITING (" + str.tostring(S.pStep) + "/5)") : "–"
    r

f_col(string v) =>
    str.startswith(v, "✓") ? C_OK : str.startswith(v, "✗") ? C_BAD : str.startswith(v, "WAITING") ? color.new(#F0B90B, 0) : C_DIM

// the strategy build shows its own results table instead (no second dashboard on top of the indicator's)
if barstate.islast and showDash and not IS_STRATEGY
    DT.clear(0, 0, 2, 43)
    int r = 0
    f_cell(0, r, "ICT SETUPS · " + INS + " · execution " + eX.tf + " · context 15M/1H/4H" + (precOn ? " · 1M precision ON" : "") + (CHART_SEC != 300 ? " · built for 5M" : ""), C_DIM, na, true), r += 1
    f_cell(0, r, "ACTION RIGHT NOW", C_DIM, C_HEAD, true), r += 1
    color abg = str.startswith(actNow, "ENTRY") ? color.new(#089981, 0) : str.startswith(actNow, "PREPARE") ? color.new(#2962FF, 0) :
         str.startswith(actNow, "MISSED") ? color.new(#F0B90B, 0) : str.startswith(actNow, "INVALIDATED") ? color.new(#F23645, 0) : color.new(#434651, 0)
    f_cell(0, r, actNow, color.white, abg, true, dashSize == "Normal" ? size.huge : size.large, text.align_center), r += 1
    f_cell(0, r, actWhy, C_TXT, na, true), r += 1
    // checklist
    f_cell(0, r, "CHECKLIST (closed candles only)", C_DIM, C_HEAD), f_cell(1, r, "LONG", C_OK, C_HEAD), f_cell(2, r, "SHORT", C_BAD, C_HEAD), r += 1
    int b1 = useB ? eB.bias() : 0
    int b4 = useA ? eA.bias() : 0
    f_cell(0, r, "1H bias", C_TXT), f_cell(1, r, f_biasCell(b1, 1), f_col(f_biasCell(b1, 1))), f_cell(2, r, f_biasCell(b1, -1), f_col(f_biasCell(b1, -1))), r += 1
    f_cell(0, r, "4H bias", C_TXT), f_cell(1, r, f_biasCell(b4, 1), f_col(f_biasCell(b4, 1))), f_cell(2, r, f_biasCell(b4, -1), f_col(f_biasCell(b4, -1))), r += 1
    f_cell(0, r, "15M location (context)", C_TXT), f_cell(1, r, f_loc15(1, SL), f_col(f_loc15(1, SL))), f_cell(2, r, f_loc15(-1, SS), f_col(f_loc15(-1, SS))), r += 1
    array<string> names = array.from(eX.tf + " liquidity sweep", eX.tf + " displacement", eX.tf + " MSS (execution)", eX.tf + " iFVG", eX.tf + " retest (closed)", "1M confirmation")
    for i = 0 to 5
        string vL = f_chk(SL, i)
        string vS = f_chk(SS, i)
        f_cell(0, r, names.get(i), C_TXT), f_cell(1, r, vL, f_col(vL)), f_cell(2, r, vS, f_col(vS)), r += 1
    // plan for the side in focus
    Setup F = actSide == -1 ? SS : SL
    if actSide != 0 and F.stage >= 3
        float Rp = F.entry - F.stop
        float riskUSD = Rp * syminfo.pointvalue
        float feeRT = 2 * FEE_SIDE
        f_cell(0, r, "PLAN — " + f_side(F.d) + (F.stage == 3 ? " (not active until ENTRY READY)" : ""), C_DIM, C_HEAD, true), r += 1
        f_cell(0, r, "Entry zone", C_TXT), f_cell(1, r, f_zoneTxt(F), C_TXT, na, true), r += 1
        f_cell(0, r, "Entry price", C_TXT), f_cell(1, r, f_real(F, F.entry) + (F.stage >= 5 and precOn and F.entry != F.entry0 ? " (1m zone)" : entryRef == "Zone edge" ? " (zone edge)" : " (50% of zone)"), C_TXT, na, true), r += 1
        f_cell(0, r, "Structural stop", C_TXT), f_cell(1, r, f_real(F, F.stop) + " · beyond the " + F.liqKind + " sweep", C_BAD, na, true), r += 1
        f_cell(0, r, "Stop distance", C_TXT), f_cell(1, r, str.tostring(Rp, format.mintick) + " pts · " + str.tostring(math.round(Rp / TICK)) + " ticks", C_TXT, na, true), r += 1
        f_cell(0, r, "Risk / contract", C_TXT), f_cell(1, r, "$" + str.tostring(riskUSD, "#,###.00") + " + $" + str.tostring(feeRT, "#.00") + " fees = $" + str.tostring(riskUSD + feeRT, "#,###.00"), C_TXT, na, true), r += 1
        if not na(F.tp1)
            f_cell(0, r, "TP1", C_TXT), f_cell(1, r, f_real(F, F.tp1) + " · " + F.tp1s + " · " + str.tostring((F.tp1 - F.entry) / Rp, "#.#") + "R", C_OK, na, true), r += 1
        f_cell(0, r, "TP2", C_TXT), f_cell(1, r, na(F.tp2) ? "none found (no invented target)" : f_real(F, F.tp2) + " · " + F.tp2s + " · " + str.tostring((F.tp2 - F.entry) / Rp, "#.#") + "R", na(F.tp2) ? C_DIM : C_OK, na, true), r += 1
        f_cell(0, r, "TP3", C_TXT), f_cell(1, r, na(F.tp3) ? "none found (no invented target)" : f_real(F, F.tp3) + " · " + F.tp3s + " · " + str.tostring((F.tp3 - F.entry) / Rp, "#.#") + "R", na(F.tp3) ? C_DIM : C_OK, na, true), r += 1
        if maxRiskUSD > 0
            int nC = int(math.floor(maxRiskUSD / (riskUSD + feeRT)))
            f_cell(0, r, "Max contracts", C_TXT), f_cell(1, r, str.tostring(nC) + " for your $" + str.tostring(maxRiskUSD, "#,###") + " max risk", C_TXT, na, true), r += 1
        string passed = "HTF context ✓ (" + F.ctx + ") · " + (F.d == 1 ? "SSL" : "BSL") + " sweep ✓ (" + F.liqKind + ") · displacement ✓ · " + eX.tf + " MSS ✓ · iFVG ✓" +
             (F.stage >= 4 ? " · retest closed ✓" : " · retest pending") + (precOn ? (F.stage >= 5 ? " · 1M ✓" : " · 1M pending") : " · 1M off")
        f_cell(0, r, "Conditions", C_TXT), f_cell(1, r, passed, C_OK, na, true), r += 1
        f_cell(0, r, "ENTRY READY = every programmed chart condition has closed and confirmed. It is NOT a proven edge: the 15-year test of this rule was negative. Targets are liquidity levels, not promises. Your decision.", C_DIM, na, true), r += 1
    // market summary (original spec)
    f_cell(0, r, "MARKET (completed candles)", C_DIM, C_HEAD, true), r += 1
    f_cell(0, r, "15M STRUCTURE (context)", C_TXT), f_cell(1, r, eC.trend == 1 ? "BULLISH" : eC.trend == -1 ? "BEARISH" : "NEUTRAL", eC.trend == 1 ? C_OK : eC.trend == -1 ? C_BAD : C_DIM, na, true), r += 1
    f_cell(0, r, eX.tf + " STRUCTURE (execution)", C_TXT), f_cell(1, r, eX.trend == 1 ? "BULLISH" : eX.trend == -1 ? "BEARISH" : "NEUTRAL", eX.trend == 1 ? C_OK : eX.trend == -1 ? C_BAD : C_DIM, na, true), r += 1
    // live, unconfirmed
    string live = "–"
    if not barstate.isconfirmed
        Setup G = actSide == -1 ? SS : actSide == 1 ? SL : SL.stage >= SS.stage ? SL : SS
        int d = G.d
        if G.stage == 1
            live := f_cl(d) > G.mssLvl ? "This candle is " + (d == 1 ? "above " : "below ") + f_real(G, G.mssLvl) + " — MSS only counts if it CLOSES there." : "Watching for a close beyond " + f_real(G, G.mssLvl) + " (MSS)."
        else if G.stage == 3
            live := f_lo(d) <= G.zTop ? "Price is inside the entry zone now — the retest counts only if this candle closes holding it." : "Price is " + str.tostring(math.abs(f_lo(d) - G.zTop), format.mintick) + " pts from the entry zone."
        else if G.stage == 4 and precOn
            live := "1-minute confirmation may be developing inside this candle — it is confirmed only at this candle's close."
        else if G.stage == 5
            live := "Limit pending at " + f_real(G, G.entry) + " · " + str.tostring(pendBars - (bar_index - G.nEntry) + 1) + " bars left."
        else
            live := "Nothing developing."
    f_cell(0, r, "LIVE BAR — NOT CONFIRMED", color.new(#787B86, 0), color.new(#1E222D, 0), true), r += 1
    f_cell(0, r, live, color.new(#9598A1, 0), color.new(#1E222D, 0), true), r += 1
    if showGloss
        f_cell(0, r, "WHAT THE WORDS MEAN", C_DIM, C_HEAD, true), r += 1
        f_cell(0, r, "SSL / BSL — sell-side / buy-side liquidity: stop orders resting below a low / above a high.\nSWEPT — price traded through that level, then a candle CLOSED back on the original side.\nDISPLACEMENT — a big, decisive candle (body ≥ " + str.tostring(dispATR) + "× ATR).\nMSS / CHoCH — market structure shift: a candle closes beyond the last short-term swing, against the prior move.\niFVG — inverse fair value gap: a gap price closed through; it now acts the opposite way.", C_DIM, na, true), r += 1
    if showStats
        string st = "History on this chart: " + str.tostring(ST.ready) + " PREPARE · " + str.tostring(ST.trades) + " filled"
        if ST.trades > 0
            st += " · win " + str.tostring(100.0 * ST.wins / ST.trades, "#") + "% · avg " + str.tostring(ST.sumR / ST.trades, "+#.##;-#.##") + "R net · net $" + str.tostring(ST.netUSD, "#,###") +
                 " · PF " + (ST.lossR < 0 ? str.tostring(ST.winR / -ST.lossR, "#.##") : "n/a") + " · max DD " + str.tostring(ST.maxDD, "#.#") + "R"
        st += "\nMissed " + str.tostring(ST.missed) + " · invalidated " + str.tostring(ST.invalid) + " · expired " + str.tostring(ST.expired) +
             (precOn ? " · no 1m conf " + str.tostring(ST.noPrec) + " · 1m data missing " + str.tostring(ST.noData) + " (excluded)" : "") +
             "\nSame-bar stop+target: " + str.tostring(ST.ambRes) + " settled by 1m bars · " + str.tostring(ST.ambUnres) + " unsettled → counted stop-first" +
             (ST.first1m > 0 ? "\n1m data available from " + str.format_time(ST.first1m, "yyyy-MM-dd", TZ) : "\n1m data: none on this chart") +
             "\nPast signals on loaded bars, after fees. Not a forecast."
        f_cell(0, r, st, C_DIM, na, true), r += 1

// ───────────────────────────────────────────── render (last bar only) ─────────────────────────
// Only live zones exist, and only the nearest few per timeframe inside the relevance distance
// are drawn — everything is rebuilt on the last bar, so no stale boxes accumulate.
var array<box>  rBoxes = array.new<box>()
var array<line> rLines = array.new<line>()
var array<label> rLabels = array.new<label>()

f_zoneColor(Zone z) =>
    z.inv ? (z.bull ? cBullInv : cBearInv) : (z.bull ? cBull : cBear)

// fill transparency by timeframe (HTF more prominent) — an iFVG is filled a little stronger than an FVG
f_fillTransp(int rank, bool inv) =>
    (rank == 3 ? 80 : rank == 2 ? 84 : rank == 1 ? 88 : 91) - (inv ? 6 : 0)

f_zoneText(Engine e, Zone z) =>
    e.tf + (z.bull ? " BULL" : " BEAR") + (z.inv ? " iFVG" : " FVG")

method render(Engine e, float px, int rightT) =>
    if e.zones.size() > 0 and maxShow > 0
        // pick nearest zones (distance 0 if price is inside)
        array<float> dist = array.new<float>()
        array<int>   idx  = array.new<int>()
        for [i, z] in e.zones
            bool visible = z.inv ? showIFVG : showFVG
            float d = px > z.top ? px - z.top : px < z.bot ? z.bot - px : 0.0
            if visible and d <= relevATR * nz(e.atr, 0)
                dist.push(d), idx.push(i)
        int shown = 0
        if dist.size() > 0
            array<int> ord = dist.sort_indices(order.ascending)
            for k = 0 to ord.size() - 1
                if shown >= maxShow
                    break
                Zone z = e.zones.get(idx.get(ord.get(k)))
                color zc = f_zoneColor(z)
                int tr = f_fillTransp(e.rank, z.inv)
                // FVG: light fill, thin solid edge · iFVG: strong dashed outline, 2 px · 1H/4H one px thicker
                int bw = (z.inv ? 2 : 1) + (e.rank >= 2 ? 1 : 0)
                rBoxes.push(box.new(z.tLeft, z.top, rightT, z.bot, xloc=xloc.bar_time,
                     border_color=color.new(zc, z.inv ? 0 : 55), border_width=bw, border_style=z.inv ? line.style_dashed : line.style_solid,
                     bgcolor=color.new(zc, tr), text=f_zoneText(e, z), text_size=e.rank >= 2 ? size.small : size.tiny,
                     // spread labels of overlapping zones: HTF centred, chart TF right; bull at the bottom, bear at the top
                     text_color=color.new(zc, 0), text_halign=e.rank >= 1 ? text.align_center : text.align_right,
                     text_valign=z.bull ? text.align_bottom : text.align_top))
                if showCE
                    float m = (z.top + z.bot) / 2
                    rLines.push(line.new(z.tLeft, m, rightT, m, xloc=xloc.bar_time, color=color.new(zc, 40), style=line.style_dotted))
                shown += 1


f_drawLiq(Liq q, int rightT) =>
    color lc = q.hi ? #F7525F : #22AB94
    int tr = q.done ? 70 : q.w >= 3 ? 25 : 45
    rLines.push(line.new(q.tMade, q.px, rightT, q.px, xloc=xloc.bar_time, color=color.new(lc, tr),
         style=q.done ? line.style_dotted : q.w >= 3 ? line.style_solid : line.style_dashed, width=1))
    string txt = (q.done ? (q.swept ? "✕ swept " : "taken ") : "") + f_liqName(q) + " " + f_px(q.px)
    rLabels.push(label.new(rightT, q.px, txt, xloc=xloc.bar_time, style=label.style_label_left,
         color=color.new(color.black, 100), textcolor=color.new(lc, q.done ? 50 : 0), size=size.tiny))

f_renderLiq(float px, int rightT) =>
    array<float> dUp = array.new<float>()
    array<int>   iUp = array.new<int>()
    array<float> dDn = array.new<float>()
    array<int>   iDn = array.new<int>()
    for [i, q] in liqs
        if not q.done
            if q.px >= px
                dUp.push(q.px - px), iUp.push(i)
            else
                dDn.push(px - q.px), iDn.push(i)
        else if q.swept and bar_index - q.nDone <= 12
            f_drawLiq(q, rightT)
    if dUp.size() > 0
        array<int> o1 = dUp.sort_indices(order.ascending)
        for k = 0 to math.min(liqShow, o1.size()) - 1
            f_drawLiq(liqs.get(iUp.get(o1.get(k))), rightT)
    if dDn.size() > 0
        array<int> o2 = dDn.sort_indices(order.ascending)
        for k = 0 to math.min(liqShow, o2.size()) - 1
            f_drawLiq(liqs.get(iDn.get(o2.get(k))), rightT)


// Candidate entry zone BEFORE a setup is ready — display only, never part of any rule.
f_candidate(Setup S, int rightT) =>
    if showPlan and (S.stage == 1 or S.stage == 2)
        int d = S.d
        color cc = color.new(color.gray, 0)
        if not na(S.z) and not S.z.dead
            rBoxes.push(box.new(S.z.tLeft, S.z.top, rightT, S.z.bot, xloc=xloc.bar_time, border_color=cc, border_style=line.style_dotted,
                 bgcolor=color.new(color.gray, 88), text="CANDIDATE " + f_side(d) + " ZONE — NOT READY (" + (S.stage == 1 ? "waiting for MSS" : "checking targets") + ")",
                 text_size=size.tiny, text_color=cc, text_halign=text.align_left, text_valign=text.align_top))
        else if S.stage == 2
            // MSS confirmed; the iFVG will be the most recent opposite FVG above the sweep once a candle closes through it
            Zone best = na
            for z in eX.zones
                if not z.inv and z.bull != (d == 1) and (d == 1 ? z.bot : -z.top) > S.ext
                    best := z
            if not na(best)
                float thr = d == 1 ? best.top : best.bot
                rBoxes.push(box.new(best.tLeft, best.top, rightT, best.bot, xloc=xloc.bar_time, border_color=cc, border_style=line.style_dotted,
                     bgcolor=color.new(color.gray, 88), text="WATCH — a " + eX.tf + " close " + (d == 1 ? "above " : "below ") + f_px(thr) + " turns this into the " + (d == 1 ? "bull" : "bear") + " iFVG · NOT READY",
                     text_size=size.tiny, text_color=cc, text_halign=text.align_left, text_valign=text.align_top))

if barstate.islast and not IS_STRATEGY
    for b in rBoxes
        b.delete()
    for ln in rLines
        ln.delete()
    for lb in rLabels
        lb.delete()
    rBoxes.clear()
    rLines.clear()
    rLabels.clear()
    int rightT = time + 12 * CHART_SEC * 1000
    if useA and on4H
        eA.render(close, rightT)
    if useB and on1H
        eB.render(close, rightT)
    if useC and on15
        eC.render(close, rightT)
    if onX
        eX.render(close, rightT)
    f_candidate(SL, rightT)
    f_candidate(SS, rightT)
    if showLiq
        f_renderLiq(close, rightT + 4 * CHART_SEC * 1000)
        if showSess and not na(sessH)
            rLines.push(line.new(sessT, sessH, rightT, sessH, xloc=xloc.bar_time, color=color.new(color.gray, 40), style=line.style_dotted))
            rLines.push(line.new(sessT, sessL, rightT, sessL, xloc=xloc.bar_time, color=color.new(color.gray, 40), style=line.style_dotted))
            rLabels.push(label.new(rightT, sessH, "SESSION H " + f_px(sessH), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny))
            rLabels.push(label.new(rightT, sessL, "SESSION L " + f_px(sessL), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny))

// ───────────────────────────────────────────── debug ──────────────────────────────────────────
f_dbg(Engine e) =>
    int nInv = 0
    for z in e.zones
        nInv += z.inv ? 1 : 0
    e.tf + " bias=" + str.tostring(e.bias()) + " trend=" + str.tostring(e.trend) + " bars=" + str.tostring(e.n) + " zones=" + str.tostring(e.zones.size()) + " inv=" + str.tostring(nInv) + " atr=" + str.tostring(e.atr, "#.##")

var label dbgL = na
if barstate.islast and debugOn
    dbgL.delete()
    dbgL := label.new(bar_index - 150, high, f_dbg(eA) + "\n" + f_dbg(eB) + "\n" + f_dbg(eC) + "\n" + f_dbg(eX) + "\nchart bars=" + str.tostring(bar_index + 1) + " liq=" + str.tostring(liqs.size()) + "\nREADY=" + str.tostring(ST.ready) + " trades=" + str.tostring(ST.trades) + " wins=" + str.tostring(ST.wins) + " sumR=" + str.tostring(ST.sumR, "#.##") + " missed=" + str.tostring(ST.missed) + " exp=" + str.tostring(ST.expired) + " inv=" + str.tostring(ST.invalid) + " ambR/U=" + str.tostring(ST.ambRes) + "/" + str.tostring(ST.ambUnres),
         style=label.style_label_left, size=size.small, color=color.new(color.black, 20), textcolor=color.white)

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// SELF-TEST — appended only to ict-selftest.pine by build-ict.sh. Feeds hand-built candles through
// the SAME Engine code the indicator uses and stops with runtime.error on the first wrong result.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
var int stChecks = 0

f_check(bool ok, string name) =>
    if not ok
        runtime.error("SELF-TEST FAILED: " + name)
    1

f_isNewHtf(int t, int last) =>
    na(last) or t != last

if barstate.isfirst
    int n = 0
    int T = 1000000
    // ── bullish FVG → wick (no inversion) → close (bear iFVG) → close back through (iFVG dies) ──
    Engine a = f_engine("T", 0, 300, 3)
    a.feed(1000, 1002, 999, 1001, T)
    a.feed(1001, 1010, 1000, 1009, 2 * T)
    n += f_check(a.zones.size() == 0, "no FVG before three candles exist")
    a.feed(1009, 1012, 1008, 1011, 3 * T)
    n += f_check(a.evBullFVG and a.zones.size() == 1, "bull FVG appears on the close of candle 3")
    Zone z = a.zones.get(0)
    n += f_check(z.bull and not z.inv and z.bot == 1002 and z.top == 1008, "bull FVG edges = candle-1 high (1002) / candle-3 low (1008)")
    n += f_check(z.tLeft == T, "zone starts at candle 1")
    a.feed(1010, 1011, 1000, 1004, 4 * T)
    n += f_check(not z.inv and z.bull and not a.evBearIFVG, "a WICK below the bottom does not invert")
    a.feed(1004, 1005, 998, 999, 5 * T)
    n += f_check(z.inv and not z.bull and a.evBearIFVG, "a CLOSE below the bottom makes a bear iFVG")
    n += f_check(z.top == 1008 and z.bot == 1002, "inversion keeps the original edges")
    a.feed(999, 1012, 998, 1010, 6 * T)
    n += f_check(z.dead, "a bear iFVG dies when a candle closes back above its top")
    // ── bearish FVG → wick (no inversion) → close (bull iFVG) ──
    Engine b = f_engine("T", 0, 300, 3)
    b.feed(1000, 1001, 998, 999, T)
    b.feed(999, 1000, 990, 991, 2 * T)
    b.feed(991, 992, 988, 989, 3 * T)
    n += f_check(b.evBearFVG and b.zones.size() == 1, "bear FVG appears on the close of candle 3")
    Zone y = b.zones.get(0)
    n += f_check(not y.bull and y.top == 998 and y.bot == 992, "bear FVG edges = candle-1 low (998) / candle-3 high (992)")
    b.feed(990, 1000, 989, 996, 4 * T)
    n += f_check(not y.inv and not b.evBullIFVG, "a WICK above the top does not invert")
    b.feed(996, 1002, 995, 1001, 5 * T)
    n += f_check(y.inv and y.bull and b.evBullIFVG, "a CLOSE above the top makes a bull iFVG")
    // ── candles that touch but do not gap make no FVG ──
    Engine c = f_engine("T", 0, 300, 3)
    c.feed(1000, 1005, 999, 1004, T)
    c.feed(1004, 1010, 1003, 1009, 2 * T)
    c.feed(1009, 1012, 1005, 1011, 3 * T)
    n += f_check(c.zones.size() == 0, "candle-3 low equal to candle-1 high is NOT a gap")
    // ── swings are only known pLen candles later ──
    Engine s = f_engine("T", 0, 300, 2)
    s.feed(100, 101, 99, 100, T)
    s.feed(100, 102, 99, 101, 2 * T)
    s.feed(101, 105, 100, 104, 3 * T)
    s.feed(104, 103, 100, 101, 4 * T)
    n += f_check(not s.evPH and na(s.lastPH), "a swing high is not known one candle after it")
    s.feed(101, 102, 99, 100, 5 * T)
    n += f_check(s.evPH and s.lastPH == 105, "the swing high is confirmed exactly pLen candles later")
    // ── higher-timeframe guard: the same completed candle is never processed twice ──
    int lastT = na
    n += f_check(f_isNewHtf(5000, lastT), "first HTF candle is processed")
    lastT := 5000
    n += f_check(not f_isNewHtf(5000, lastT), "the same HTF candle is not processed again")
    n += f_check(f_isNewHtf(6000, lastT), "the next HTF candle is processed")
    stChecks := n
    log.info("ICT SELF-TEST: all {0} checks passed", n)

var label stLbl = na
if barstate.islast
    stLbl.delete()
    stLbl := label.new(bar_index, high, "ICT SELF-TEST: ALL " + str.tostring(stChecks) + " CHECKS PASSED", style=label.style_label_down,
         color=color.new(#089981, 0), textcolor=color.white, size=size.normal)

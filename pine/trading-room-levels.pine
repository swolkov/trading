//@version=6
// TRADING ROOM - the level set (Sep 2026). Apply to MES1!, MNQ1! and MGC1! on the 5-MINUTE chart.
// Draws the same numbers the admin page's Trading Room shows - prior exchange-day high/low/close,
// overnight high/low, the running week's high/low, the opening range, session VWAP - and posts ONE
// message per level break at the 5-minute close to the room's webhook, where it lands on the tape
// and in Slack. These are REFERENCE lines, not signals: on 15 years of our own 1-minute data no
// opening-range breakout rule survives (Research/orb-study-sep19.md). The tape exists so the
// journal can later say which breaks Spencer took, and whether they paid.
//
// The permission panel (bottom right) is five checks - window, level, volume, VWAP side, day range - and a
// verdict: "OK to look" only when the first three are green. It is not a signal and never names a direction.
// Setup, once: paste the webhook secret into the study's settings (the session picks itself: gold
// 08:20-13:30, indices 09:30-16:00); then ONE alert per symbol -> condition "Any alert() function
// call" -> webhook URL https://trading-eta-snowy.vercel.app/api/webhook/trading-room, message left
// empty. Breaks post inside RTH only, at most one per kind every 30 minutes.
indicator("Trading Room - levels", overlay = true, max_labels_count = 50)

secret     = input.string("", "Room webhook secret")
autoSess   = input.bool(true, "Session by symbol (gold 0820-1330, indices 0930-1600)")
rthSess    = input.session("0930-1600", "RTH session, ET - used only when the switch above is off")
orMin      = input.int(15, "Opening range minutes", minval = 5, maxval = 60)
showVwap   = input.bool(true, "Show session VWAP")
sendAlerts = input.bool(true, "Post level breaks to the room")
cooldown   = input.int(6, "Bars between repeat posts of the same break", minval = 1)
tz = "America/New_York"

isGold   = syminfo.root == "MGC" or syminfo.root == "GC"
sess     = autoSess ? (isGold ? "0820-1330" : "0930-1600") : rthSess
inRth    = not na(time(timeframe.period, sess, tz))
rthStart = inRth and not inRth[1]
rthEnd   = not inRth and inRth[1]

// Prior EXCHANGE day - the daily bar's [1], the standard non-repainting read.
[pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

// The running week: reset when the weekly bar rolls (Sunday 18:00 ET on CME), then track.
var float wkH = na
var float wkL = na
newWeek = ta.change(time("W")) != 0
wkHprev = wkH
wkLprev = wkL
if newWeek or na(wkH)
    wkH := high
    wkL := low
else
    wkH := math.max(wkH, high)
    wkL := math.min(wkL, low)

// Overnight: from the RTH close to the next RTH open; frozen once RTH starts.
var float onH = na
var float onL = na
var bool onActive = false
if rthEnd
    onH := high
    onL := low
    onActive := true
else if onActive and not inRth
    onH := math.max(onH, high)
    onL := math.min(onL, low)
if rthStart
    onActive := false

// Opening range: the first orMin minutes of RTH.
var float orH = na
var float orL = na
var int orStart = na
var bool orDone = false
if rthStart
    orH := high
    orL := low
    orStart := time
    orDone := false
else if inRth and not orDone
    if time - orStart < orMin * 60000
        orH := math.max(orH, high)
        orL := math.min(orL, low)
    else
        orDone := true

vwap = ta.vwap(hlc3)
atr = ta.atr(14)
atrD = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
volRatio = volume / ta.sma(volume, 20)

// ---- draw ----
plot(pdh, "Prior-day high", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 1)
plot(pdl, "Prior-day low", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 1)
plot(pdc, "Prior-day close", color = color.new(color.orange, 50), style = plot.style_linebr, linewidth = 1)
plot(onActive ? na : onH, "Overnight high", color = color.new(color.aqua, 0), style = plot.style_linebr)
plot(onActive ? na : onL, "Overnight low", color = color.new(color.aqua, 0), style = plot.style_linebr)
plot(wkH, "Week high", color = color.new(color.purple, 30), style = plot.style_linebr)
plot(wkL, "Week low", color = color.new(color.purple, 30), style = plot.style_linebr)
plot(orDone and inRth ? orH : na, "OR high", color = color.new(color.yellow, 0), style = plot.style_linebr, linewidth = 2)
plot(orDone and inRth ? orL : na, "OR low", color = color.new(color.yellow, 0), style = plot.style_linebr, linewidth = 2)
plot(showVwap ? vwap : na, "VWAP", color = color.new(color.white, 30))
bgcolor(inRth and not orDone ? color.new(color.yellow, 92) : na)

var table t = table.new(position.top_right, 2, 9, bgcolor = chart.bg_color, border_width = 1)
fmt(float x) => na(x) ? "-" : str.tostring(x, format.mintick)
if barstate.islast
    table.cell(t, 0, 0, "Level", text_size = size.small, text_color = color.gray)
    table.cell(t, 1, 0, syminfo.root, text_size = size.small, text_color = color.gray)
    table.cell(t, 0, 1, "PDH / PDL", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 1, fmt(pdh) + " / " + fmt(pdl), text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 2, "PDC", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 2, fmt(pdc), text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 3, "ON H / L", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 3, fmt(onH) + " / " + fmt(onL), text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 4, "Week H / L", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 4, fmt(wkH) + " / " + fmt(wkL), text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 5, "OR H / L", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 5, orDone ? fmt(orH) + " / " + fmt(orL) : "forming", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 6, "VWAP", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 6, fmt(vwap), text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 7, "ATR(14) " + timeframe.period + "m", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 7, fmt(atr), text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 0, 8, "Vol / 20-bar avg", text_size = size.small, text_color = chart.fg_color)
    table.cell(t, 1, 8, na(volRatio) ? "-" : str.tostring(volRatio, "#.0") + "x", text_size = size.small, text_color = chart.fg_color)

// ---- the permission panel (Sep 20 2026): five checks, never a signal. Green means this is a moment where a
// trade has a definable stop (near a level), a market that is actually moving (volume), and the time of day
// that pays in our data (the first hour); red means sit on hands. Direction is not judged - VWAP only says
// which side the day's average buyer allows. On 15 years of data no entry indicator survives costs; what
// decides the month is how often the button gets pressed. This panel exists to make that number smaller.
var float rthH = na
var float rthL = na
if rthStart
    rthH := high
    rthL := low
else if inRth
    rthH := math.max(rthH, high)
    rthL := math.min(rthL, low)
// The panel reads the 5-MINUTE ATR and volume whatever timeframe the chart is on (a 1-minute chart would
// otherwise make every stop look tiny and every bar look quiet).
[atr5, vr5] = request.security(syminfo.tickerid, "5", [ta.atr(14), volRatio[1]])
dist(float x) => na(x) ? 1e10 : math.abs(close - x)
nearest = math.min(dist(pdh), dist(pdl), dist(pdc), dist(onActive ? na : onH), dist(onActive ? na : onL), dist(wkH), dist(wkL), dist(orDone ? orH : na), dist(orDone ? orL : na), dist(vwap))
hNow = hour(timenow, tz) + minute(timenow, tz) / 60.0
dow = dayofweek(timenow, tz)
weekday = dow >= dayofweek.monday and dow <= dayofweek.friday
openH = isGold ? 8.0 + 20.0 / 60.0 : 9.5
winState = not weekday ? 0 : hNow >= openH and hNow < 10.5 ? 2 : hNow >= 10.5 and hNow < 11.5 ? 1 : 0
lvlState = na(atr5) or atr5 <= 0 ? 0 : nearest <= 0.5 * atr5 ? 2 : nearest <= 1.0 * atr5 ? 1 : 0
vr = vr5
volState = na(vr) ? 0 : vr >= 1.5 ? 2 : vr >= 0.8 ? 1 : 0
rangeRatio = inRth and not na(atrD) and atrD > 0 ? (rthH - rthL) / atrD : na
rngState = na(rangeRatio) ? 0 : rangeRatio < 0.8 ? 2 : rangeRatio <= 1.2 ? 1 : 0
col(int s) => s == 2 ? color.new(color.green, 60) : s == 1 ? color.new(color.orange, 60) : color.new(color.red, 60)
okToLook = winState == 2 and lvlState == 2 and volState == 2
var table p = table.new(position.bottom_right, 2, 6, bgcolor = chart.bg_color, border_width = 1)
if barstate.islast
    table.cell(p, 0, 0, "Window", text_size = size.small, text_color = chart.fg_color)
    table.cell(p, 1, 0, winState == 2 ? "open window" : winState == 1 ? "late morning" : weekday ? "outside the window" : "weekend", text_size = size.small, text_color = chart.fg_color, bgcolor = col(winState))
    table.cell(p, 0, 1, "Level", text_size = size.small, text_color = chart.fg_color)
    table.cell(p, 1, 1, na(atr5) or atr5 <= 0 ? "-" : str.tostring(nearest / atr5, "0.0") + " x 5m ATR away", text_size = size.small, text_color = chart.fg_color, bgcolor = col(lvlState))
    table.cell(p, 0, 2, "Volume", text_size = size.small, text_color = chart.fg_color)
    table.cell(p, 1, 2, na(vr) ? "-" : "last 5m bar " + str.tostring(vr, "0.0") + "x avg", text_size = size.small, text_color = chart.fg_color, bgcolor = col(volState))
    table.cell(p, 0, 3, "VWAP side", text_size = size.small, text_color = chart.fg_color)
    table.cell(p, 1, 3, na(vwap) ? "-" : close > vwap ? "longs only" : close < vwap ? "shorts only" : "at VWAP", text_size = size.small, text_color = chart.fg_color, bgcolor = color.new(color.blue, 70))
    table.cell(p, 0, 4, "Day range", text_size = size.small, text_color = chart.fg_color)
    table.cell(p, 1, 4, na(rangeRatio) ? "-" : str.tostring(rangeRatio, "0.0") + "x daily ATR", text_size = size.small, text_color = chart.fg_color, bgcolor = col(rngState))
    table.cell(p, 0, 5, "Verdict", text_size = size.small, text_color = chart.fg_color)
    table.cell(p, 1, 5, okToLook ? "OK to look" : "sit on hands", text_size = size.small, text_color = chart.fg_color, bgcolor = okToLook ? color.new(color.green, 40) : color.new(color.red, 40))

// ---- the tape: one message per level break at the 5-minute close, inside RTH, with a cooldown per kind ----
var kinds = array.from("or_up", "or_down", "pdh_up", "pdl_down", "onh_up", "onl_down", "wh_up", "wl_down", "vwap_up", "vwap_down")
var lastFired = array.new_int(10, -1000)
num(float x) => na(x) ? "null" : str.tostring(x)
post(string kind, float level) =>
    i = array.indexof(kinds, kind)
    if bar_index - array.get(lastFired, i) >= cooldown
        array.set(lastFired, i, bar_index)
        alert('{"secret":"' + secret + '","room":"trading","symbol":"' + syminfo.root + '","kind":"' + kind + '","price":' + str.tostring(close) + ',"level":' + num(level) + ',"atr":' + num(atr) + ',"volRatio":' + num(volRatio) + ',"bar":' + str.tostring(time) + ',"tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)

crossedUp(float lvl) => not na(lvl) and close > lvl and close[1] <= lvl
crossedDn(float lvl) => not na(lvl) and close < lvl and close[1] >= lvl

// The whole level set, once per confirmed bar, 24/5 - the room uses it as the card while it is fresh,
// so the admin page shows these exact numbers instead of a delayed Yahoo copy.
if barstate.isconfirmed and sendAlerts
    alert('{"secret":"' + secret + '","room":"trading","kind":"levels","symbol":"' + syminfo.root + '","price":' + str.tostring(close) + ',"pdh":' + num(pdh) + ',"pdl":' + num(pdl) + ',"pdc":' + num(pdc) + ',"onh":' + num(onActive ? na : onH) + ',"onl":' + num(onActive ? na : onL) + ',"wh":' + num(wkH) + ',"wl":' + num(wkL) + ',"orh":' + num(orH) + ',"orl":' + num(orL) + ',"orDone":' + (orDone ? "true" : "false") + ',"vwap":' + num(vwap) + ',"atr":' + num(atr) + ',"atrD":' + num(atrD) + ',"bar":' + str.tostring(time) + ',"tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)

if barstate.isconfirmed and inRth and sendAlerts
    if orDone
        if crossedUp(orH)
            post("or_up", orH)
        if crossedDn(orL)
            post("or_down", orL)
    if crossedUp(pdh)
        post("pdh_up", pdh)
    if crossedDn(pdl)
        post("pdl_down", pdl)
    if not onActive
        if crossedUp(onH)
            post("onh_up", onH)
        if crossedDn(onL)
            post("onl_down", onL)
    if crossedUp(wkHprev)
        post("wh_up", wkHprev)
    if crossedDn(wkLprev)
        post("wl_down", wkLprev)
    if showVwap
        if crossedUp(vwap)
            post("vwap_up", vwap)
        if crossedDn(vwap)
            post("vwap_down", vwap)
